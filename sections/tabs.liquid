      "placeholder": "t:settings.default"
    },
    {
      "type": "color",
      "id": "active_color",
      "label": "t:settings.active_text",
      "placeholder": "t:settings.default"
    },
    {
      "type": "color",
      "id": "indicator_color",
      "label": "t:settings.indicator_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.borders"
    },
    {
      "type": "checkbox",
      "id": "border_top",
      "label": "t:settings.top_border",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "border_bottom",
      "label": "t:settings.bottom_border",
      "default": false
    },
    {
      "type": "range",
      "id": "border_width",
      "min": 1,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:settings.thickness",
      "default": 1,
      "visible_if": "{{ section.settings.border_top or section.settings.border_bottom }}"
    },
    {
      "type": "range",
      "id": "border_opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "t:settings.opacity",
      "default": 100,
      "visible_if": "{{ section.settings.border_top or section.settings.border_bottom }}"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "t:settings.color",
      "placeholder": "t:settings.default",
      "visible_if": "{{ section.settings.border_top or section.settings.border_bottom }}"
    },
    {
      "type": "header",
      "content": "t:content.size"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "t:names.tabs",
      "category": "t:categories.layout",
      "blocks": {
        "tab-1": {
          "type": "_tab",
          "settings": {
            "heading": "t:text_defaults.description",
            "content": "t:html_defaults.share_information_about_your",
            "open_by_default": true
          }
        },
        "tab-2": {
          "type": "_tab",
          "settings": {
            "heading": "t:text_defaults.compare_ingredients",
            "content": "t:html_defaults.authentic_materials"
          }
        },
        "tab-3": {
          "type": "_tab",
          "settings": {
            "heading": "t:text_defaults.shipping",
            "content": "t:html_defaults.work_quickly_to_ship"
          }
        }
      },
      "block_order": ["tab-1", "tab-2", "tab-3"]
    }
  ]
}
{% endschema %}
