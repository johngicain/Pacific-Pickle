{% capture items %}
  {% content_for 'blocks' %}
{% endcapture %}

{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, text_color: section.settings.text_color, section_id: section.id
  endif
%}

{% if section.settings.border_top or section.settings.border_bottom %}
  {% style %}
    #shopify-section-{{ section.id }} {
      {%- if section.settings.border_color != blank -%}
        --tabs-section-border-color: rgb({{ section.settings.border_color.rgba }});
      {%- else -%}
        --tabs-section-border-color: rgb(var(--color-border-rgb) / {{ section.settings.border_opacity | default: 100 | divided_by: 100.0 }});
      {%- endif -%}
      {%- if section.settings.border_top -%}
        border-block-start: {{ section.settings.border_width | default: 1 }}px solid var(--tabs-section-border-color);
      {%- endif -%}
      {%- if section.settings.border_bottom -%}
        border-block-end: {{ section.settings.border_width | default: 1 }}px solid var(--tabs-section-border-color);
      {%- endif -%}
    }
  {% endstyle %}
{% endif %}

<div class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"></div>
<div
  class="section section--{{ section.settings.section_width }} spacing-style{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
  style="{% render 'spacing-style', settings: section.settings %}"
>
  {% render 'tabs',
    items: items,
    settings: section.settings,
    id: section.id
  %}
</div>

{% stylesheet %}
  .shopify-section.tabs-section {
    box-sizing: border-box;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.tabs",
  "tag": "section",
  "class": "tabs-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "blocks": [
    {
      "type": "_tab"
    }
  ],
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:settings.heading"
    },
    {
      "type": "text_alignment",
      "id": "heading_alignment",
      "label": "t:settings.alignment",
      "default": "left",
      "visible_if": "{{ section.settings.heading != blank }}"
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "tab_style",
      "label": "t:settings.style",
      "options": [
        {
          "value": "underline",
          "label": "t:options.underline"
        },
        {
          "value": "pills",
          "label": "t:options.pills"
        },
        {
          "value": "boxed",
          "label": "t:options.boxed"
        }
      ],
      "default": "underline"
    },
    {
      "type": "select",
      "id": "tab_alignment",
      "label": "t:settings.alignment",
      "options": [
        {
          "value": "start",
          "label": "t:options.left"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "fill",
          "label": "t:options.fill"
        }
      ],
      "default": "start"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 48,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "content_padding",
      "label": "t:settings.content_padding",
      "min": 0,
      "max": 80,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "select",
      "id": "panel_max_width",
      "label": "t:settings.max_width",
      "options": [
        {
          "value": "none",
          "label": "t:options.none"
        },
        {
          "value": "custom",
          "label": "t:options.custom"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "panel_custom_max_width",
      "label": "t:settings.custom_width",
      "min": 200,
      "max": 1200,
      "step": 10,
      "unit": "px",
      "default": 720,
      "visible_if": "{{ section.settings.panel_max_width == 'custom' }}"
    },
    {
      "type": "header",
      "content": "t:content.typography"
    },
    {
      "type": "select",
      "id": "type_preset",
      "label": "t:settings.heading_preset",
      "options": [
        {
          "value": "",
          "label": "t:options.default"
        },
        {
          "value": "paragraph",
          "label": "t:options.paragraph"
        },
        {
          "value": "h1",
          "label": "t:options.h1"
        },
        {
          "value": "h2",
          "label": "t:options.h2"
        },
        {
          "value": "h3",
          "label": "t:options.h3"
        },
        {
          "value": "h4",
          "label": "t:options.h4"
        },
        {
          "value": "h5",
          "label": "t:options.h5"
        },
        {
          "value": "h6",
          "label": "t:options.h6"
        },
        {
          "value": "custom",
          "label": "t:options.custom"
        }
      ],
      "default": "h6",
      "info": "t:info.edit_presets_in_theme_settings"
    },
    {
      "type": "select",
      "id": "font",
      "label": "t:settings.font",
      "options": [
        {
          "value": "",
          "label": "t:options.default"
        },
        {
          "value": "var(--font-body--family)",
          "label": "t:options.body"
        },
        {
          "value": "var(--font-subheading--family)",
          "label": "t:options.subheading"
        },
        {
          "value": "var(--font-heading--family)",
          "label": "t:options.heading"
        },
        {
          "value": "var(--font-accent--family)",
          "label": "t:options.accent"
        }
      ],
      "default": ""
    },
    {
      "type": "select",
      "id": "font_size",
      "label": "t:settings.font_size",
      "options": [
        {
          "value": "",
          "label": "t:options.default"
        },
        {
          "value": "0.625rem",
          "label": "10px"
        },
        {
          "value": "0.75rem",
          "label": "12px"
        },
        {
          "value": "0.875rem",
          "label": "14px"
        },
        {
          "value": "1rem",
          "label": "16px"
        },
        {
          "value": "1.125rem",
          "label": "18px"
        },
        {
          "value": "1.25rem",
          "label": "20px"
        },
        {
          "value": "1.5rem",
          "label": "24px"
        },
        {
          "value": "2rem",
          "label": "32px"
        }
      ],
      "default": ""
    },
    {
      "type": "select",
      "id": "weight",
      "label": "t:settings.weight",
      "options": [
        {
          "value": "",
          "label": "t:options.default"
        },
        {
          "value": "100",
          "label": "t:options.thin"
        },
        {
          "value": "300",
          "label": "t:options.light"
        },
        {
          "value": "400",
          "label": "t:options.regular"
        },
        {
          "value": "500",
          "label": "t:options.medium"
        },
        {
          "value": "600",
          "label": "t:options.semibold"
        },
        {
          "value": "700",
          "label": "t:options.bold"
        },
        {
          "value": "900",
          "label": "t:options.black"
        }
      ],
      "default": ""
    },
    {
      "type": "select",
      "id": "case",
      "label": "t:settings.case",
      "options": [
        {
          "value": "",
          "label": "t:options.default"
        },
        {
          "value": "none",
          "label": "t:options.none"
        },
        {
          "value": "uppercase",
          "label": "t:options.uppercase"
        }
      ],
      "default": ""
    },
    {
      "type": "header",
