
<script
  src="{{ 'blog-posts-list.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif

  assign show_featured = section.settings.show_featured
  if current_tags != blank
    assign show_featured = false
  endif
%}

<blog-posts-list section-id="{{ section.id }}">
  <div
    class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
  ></div>
  <div
    class="
      section
      section--{{ section.settings.section_width }}
      {% if section.settings.background_color != blank %}color-custom-{{ section.id }}{% endif %}
      blog-posts
      spacing-style
      size-style
      {% if show_featured %}blog-posts--featured{% endif %}
    "
    data-testid="blog-posts"
    style="{% render 'spacing-style', settings: section.settings %}"
  >
    {% content_for 'blocks' %}

    <div
      ref="grid"
      class="
        blog-posts-container
        {% if section.settings.card_box_shadow %}blog-posts-container--box-shadow{% endif %}
        {% if section.settings.reveal_on_hover %}blog-posts-container--hover-reveal{% endif %}
      "
      style="
        --blog-columns: {{ section.settings.columns }};
        --blog-columns-mobile: {{ section.settings.mobile_columns }};
        --columns-gap: {{ section.settings.columns_gap }}px;
        --rows-gap: {{ section.settings.rows_gap }}px;
        --featured-gap: {{ section.settings.featured_gap }}px;
        {% if section.settings.hover_title_color != blank %}
          --blog-hover-title-color: {{ section.settings.hover_title_color }};
        {% endif %}
      "
    >
      {% for article in blog.articles %}
        {% liquid
          assign is_featured = false
          if show_featured and forloop.first
            assign is_featured = true
          endif
        %}
        <div
          class="blog-post-item{% if is_featured %} blog-post-item--horizontal blog-post-item--featured{% endif %}"
          data-testid="blog-post-item"
          data-blog-index="{{ section.id }}-{{ forloop.index }}"
          data-category="{{ article.metafields.custom.category.value | handleize }}"
        >
          {% if is_featured %}
            {% content_for 'block',
              id: 'static-featured-post-card',
              type: '_featured-blog-posts-card',
              article: article,
              closest.article: article
            %}
          {% else %}
            {% content_for 'block',
              id: 'static-blog-post-card',
              type: '_featured-blog-posts-card',
              article: article,
              closest.article: article
            %}
          {% endif %}
        </div>
      {% else %}
        <div class="blog-posts-empty">
          <p>No recipes found.</p>
        </div>
      {% endfor %}
    </div>
  </div>
</blog-posts-list>

{% stylesheet %}
  .blog-posts {
    --page-content-width: var(--normal-page-width);
    --page-width: calc(var(--page-content-width) + (var(--page-margin) * 2));
  }

  .blog-posts-container {
    display: grid;
    grid-template-columns: repeat(var(--blog-columns, 2), minmax(0, 1fr));
    width: 100%;
    column-gap: var(--columns-gap, 24px);
    row-gap: var(--rows-gap, 24px);
  }

  .blog-post-item {
    min-width: 0;
  }

  .blog-post-item .featured-blog-posts-card {
    transition:
      top var(--hover-transition-duration) var(--hover-transition-timing),
      box-shadow var(--hover-transition-duration) var(--hover-transition-timing),
      border-color var(--hover-transition-duration) var(--hover-transition-timing);
  }

  .blog-post-item .text-block:is(.h1, .h2, .h3, .h4, .h5, .h6) {
    transition: color var(--hover-transition-duration) var(--hover-transition-timing);
  }

  .blog-posts-container--box-shadow .blog-post-item .featured-blog-posts-card {
    box-shadow: 3px 3px var(--color-foreground);
  }

  .blog-posts-container:not(.blog-posts-container--box-shadow) .blog-post-item .featured-blog-posts-card {
    box-shadow: none;
  }

  .blog-posts-container--hover-reveal .blog-post-item .featured-blog-posts-card--hover-lift:hover {
    top: 0;
  }

  .blog-posts-container--hover-reveal .blog-post-item a.button-unstyled {
    display: none;
    opacity: 0;
    translate: 0 4px;
    transition:
      opacity var(--hover-transition-duration) var(--hover-transition-timing),
      translate var(--hover-transition-duration) var(--hover-transition-timing),
      display var(--hover-transition-duration) allow-discrete;
  }

  .blog-posts-container--hover-reveal .blog-post-item:hover a.button-unstyled {
    display: block;
    opacity: 1;
    translate: 0 0;
  }

  @starting-style {
    .blog-posts-container--hover-reveal .blog-post-item:hover a.button-unstyled {
      opacity: 0;
      translate: 0 4px;
    }
  }

  .blog-posts-container--hover-reveal .blog-post-item:hover .text-block:is(.h1, .h2, .h3, .h4, .h5, .h6) {
    color: var(--blog-hover-title-color, var(--color-foreground-subdued));
  }

  .blog-post-item--featured {
    grid-column: 1 / -1;
    margin-block-end: max(0px, calc(var(--featured-gap, 24px) - var(--rows-gap, 24px)));
  }

  @media screen and (max-width: 749px) {
    .blog-posts-container {
      grid-template-columns: repeat(var(--blog-columns-mobile, 1), minmax(0, 1fr));
    }
  }

  .blog-post-item--horizontal .featured-blog-posts-card {
    height: 100%;
  }

  .blog-post-item--horizontal .featured-blog-posts-card__inner {
    flex-direction: row;
    min-height: 22rem;
  }

  .blog-post-item--horizontal .featured-blog-posts-card__image {
    flex: 1 1 50%;
    min-width: 0;
    height: auto;
    align-self: stretch;
  }

  .blog-post-item--horizontal .featured-blog-posts-card__image .resource-image__image,
  .blog-post-item--horizontal .featured-blog-posts-card__image .blog-placeholder-svg {
    height: 100%;
    aspect-ratio: unset;
    object-fit: cover;
  }

  .blog-post-item--horizontal .featured-blog-posts-card__inner > .group-block {
    flex: 1 1 50%;
    min-width: 0;
    justify-content: center;
  }

  .blog-post-item--featured {
    position: relative;
  }

  .blog-post-item--featured::before {
    content: '✦ Featured Recipe';
    position: absolute;
    top: 1rem;
    left: 1rem;
    z-index: 2;
    background: #e8821a;
    color: #fff;
    font-family: var(--font-body--family);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.4rem 0.75rem;
    pointer-events: none;
  }

  .blog-post-item--featured .featured-blog-posts-card .text-block:is(.h1, .h2, .h3, .h4, .h5, .h6),
  .blog-post-item--featured .featured-blog-posts-card .text-block:is(.h1, .h2, .h3, .h4, .h5, .h6) > * {
    white-space: normal;
    overflow: visible;
    text-overflow: unset;
    -webkit-line-clamp: unset;
    line-clamp: unset;
  }

  .blog-post-item--featured .blog-post-card__content-text,
  .blog-post-item--featured .blog-post-card__content-text * {
    -webkit-line-clamp: 3;
    line-clamp: 3;
  }

  .blog-posts-container--hover-reveal .blog-post-item--featured:hover .text-block:is(.h1, .h2, .h3, .h4, .h5, .h6) {
    color: var(--blog-hover-title-color, var(--color-foreground-subdued));
  }

  @media (prefers-reduced-motion: reduce) {
    .blog-post-item .featured-blog-posts-card,
    .blog-post-item .text-block:is(.h1, .h2, .h3, .h4, .h5, .h6),
    .blog-posts-container--hover-reveal .blog-post-item a.button-unstyled {
      transition: none;
    }
  }

  .blog-posts-empty {
    grid-column: 1 / -1;
    text-align: center;
    padding: 3rem 1rem;
  }

  .blog-post-item--featured .text-block :is(h1, h2, h3, h4, h5, h6),
  .blog-post-item--featured .text-block > * {
    white-space: normal;
    text-overflow: unset;
    overflow: visible;
    -webkit-line-clamp: unset;
    line-clamp: unset;
  }

  @media screen and (max-width: 749px) {
    .blog-post-item--horizontal .featured-blog-posts-card__inner {
      flex-direction: column;
      min-height: 0;
    }

    .blog-post-item--horizontal .featured-blog-posts-card__inner > .group-block {
      padding-block: 1.25rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.blog_posts",
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    },
    {
      "type": "text"
    },
    {
      "type": "icon"
    },
    {
      "type": "image"
    },
    {
      "type": "button"
    },
    {
      "type": "video"
    },
    {
      "type": "group"
    },
    {
      "type": "spacer"
    },
    {
      "type": "_divider"
    },
    {
      "type": "_featured-blog-posts-card"
    },
    {
      "type": "_featured-blog-posts-image"
    },
    {
      "type": "custom-liquid"
    }
  ],
  "disabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "show_featured",
      "label": "Show featured recipe",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "link_unstyled_buttons_to_article",
      "label": "t:settings.link_unstyled_buttons_to_article",
      "info": "t:info.link_unstyled_buttons_to_article",
      "default": true
    },
    {
      "type": "range",
      "id": "columns",
      "label": "t:settings.columns",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 2
    },
    {
      "type": "select",
      "id": "mobile_columns",
      "label": "t:settings.mobile_columns",
      "options": [
        {
          "value": "1",
          "label": "t:options.one_number"
        },
        {
          "value": "2",
          "label": "t:options.two_number"
        }
      ],
      "default": "1"
    },
    {
      "type": "range",
      "id": "columns_gap",
      "label": "t:settings.horizontal_gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "rows_gap",
      "label": "t:settings.vertical_gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "checkbox",
      "id": "card_box_shadow",
      "label": "t:settings.box_shadow",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "reveal_on_hover",
      "label": "Reveal actions on hover",
      "info": "Hides the card button until hover and disables the card lift. Image zoom is kept.",
      "default": false
    },
    {
      "type": "color",
      "id": "hover_title_color",
      "label": "Title hover color",
      "placeholder": "t:settings.default",
      "visible_if": "{{ section.settings.reveal_on_hover }}"
    },
    {
      "type": "range",
      "id": "featured_gap",
      "label": "Featured recipe vertical gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24,
      "visible_if": "{{ section.settings.show_featured }}"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ]
}
{% endschema %}
