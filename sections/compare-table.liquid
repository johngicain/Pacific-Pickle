

{% liquid
  assign section_settings = section.settings

  if section_settings.background_color != blank
    render 'contrast-override', background_color: section_settings.background_color, section_id: section.id
  endif
%}

<div class="section-background{% if section_settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"></div>

<div
  class="section section--{{ section_settings.section_width }} spacing-style{% if section_settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
  style="
    {% render 'compare-table-intro-style', settings: section_settings %}
    --compare-header-bg: {{ section_settings.header_background }};
    --compare-header-text: {{ section_settings.header_text }};
    --compare-ours: {{ section_settings.ours_color }};
    --compare-stripe: {{ section_settings.stripe_color }};
    --compare-row: {{ section_settings.row_color }};
    --compare-border: {{ section_settings.border_color }};
    --compare-border-width: {{ section_settings.border_width }}px;
    --compare-border-style: {{ section_settings.border }};
    --compare-feature-max-width: {{ section_settings.feature_max_width }}%;
    {% render 'compare-table-header-style', settings: section_settings %}
    {% render 'spacing-style', settings: section_settings %}
  "
>
  <div class="ppw-compare-stack{% if section_settings.narrow_width %} ppw-compare-stack--narrow{% endif %}">
    {% if section_settings.heading != blank or section_settings.text != blank %}
      <div class="ppw-compare__intro{% if section_settings.intro_narrow_width or section_settings.narrow_width %} ppw-compare__intro--narrow{% endif %}">
        {% if section_settings.heading != blank %}
          <h2 class="ppw-compare__heading{% if section_settings.heading_narrow_width %} ppw-compare__heading--narrow{% endif %}">
            {{ section_settings.heading }}
          </h2>
        {% endif %}
        {% if section_settings.text != blank %}
          <div class="ppw-compare__text rte{% if section_settings.text_narrow_width %} ppw-compare__text--narrow{% endif %}">
            {{ section_settings.text }}
          </div>
        {% endif %}
      </div>
    {% endif %}

    <div class="ppw-compare{% if section_settings.narrow_width %} ppw-compare--narrow{% endif %}">
      <table>
      <thead>
        <tr>
          <th
            scope="col"
            style="
              --compare-cell-align: {{ section_settings.header_feature_alignment }};
              {% if section_settings.header_feature_color != blank -%}
                --compare-cell-color: {{ section_settings.header_feature_color }};
              {% endif -%}
              {% if section_settings.header_feature_background != blank -%}
                --compare-cell-bg: {{ section_settings.header_feature_background }};
              {% endif -%}
            "
          >
            {{ section_settings.feature_heading }}
          </th>
          <th
            scope="col"
            style="
              --compare-cell-align: {{ section_settings.header_ours_alignment }};
              {% if section_settings.header_ours_color != blank -%}
                --compare-cell-color: {{ section_settings.header_ours_color }};
              {% endif -%}
              {% if section_settings.header_ours_background != blank -%}
                --compare-cell-bg: {{ section_settings.header_ours_background }};
              {% endif -%}
            "
          >
            {{ section_settings.ours_heading }}
          </th>
          <th
            scope="col"
            style="
              --compare-cell-align: {{ section_settings.header_theirs_alignment }};
              {% if section_settings.header_theirs_color != blank -%}
                --compare-cell-color: {{ section_settings.header_theirs_color }};
              {% endif -%}
              {% if section_settings.header_theirs_background != blank -%}
                --compare-cell-bg: {{ section_settings.header_theirs_background }};
              {% endif -%}
            "
          >
            {{ section_settings.theirs_heading }}
          </th>
        </tr>
      </thead>
      <tbody>
        {% content_for 'blocks' %}
      </tbody>
    </table>
  </div>
  </div>
</div>

{% render 'compare-table-styles' %}

