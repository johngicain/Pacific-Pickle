{% liquid
  assign section_settings = section.settings

  if section_settings.background_color != blank
    render 'contrast-override', background_color: section_settings.background_color, section_id: section.id
  endif

  if section_settings.caption_letter_spacing == 'custom'
    assign caption_letter_spacing = section_settings.caption_letter_spacing_custom | append: 'px'
  elsif section_settings.caption_letter_spacing != blank
    assign caption_letter_spacing = 'var(--letter-spacing--heading-' | append: section_settings.caption_letter_spacing | append: ')'
  endif

  if section_settings.heading_letter_spacing == 'custom'
    assign heading_letter_spacing = section_settings.heading_letter_spacing_custom | append: 'px'
  elsif section_settings.heading_letter_spacing != blank
    assign heading_letter_spacing = 'var(--letter-spacing--heading-' | append: section_settings.heading_letter_spacing | append: ')'
  endif

  if section_settings.year_letter_spacing == 'custom'
    assign year_letter_spacing = section_settings.year_letter_spacing_custom | append: 'px'
  elsif section_settings.year_letter_spacing != blank
    assign year_letter_spacing = 'var(--letter-spacing--heading-' | append: section_settings.year_letter_spacing | append: ')'
  endif

  if section_settings.item_heading_letter_spacing == 'custom'
    assign item_heading_letter_spacing = section_settings.item_heading_letter_spacing_custom | append: 'px'
  elsif section_settings.item_heading_letter_spacing != blank
    assign item_heading_letter_spacing = 'var(--letter-spacing--heading-' | append: section_settings.item_heading_letter_spacing | append: ')'
  endif

  if section_settings.item_text_letter_spacing == 'custom'
    assign item_text_letter_spacing = section_settings.item_text_letter_spacing_custom | append: 'px'
  elsif section_settings.item_text_letter_spacing != blank
    assign item_text_letter_spacing = 'var(--letter-spacing--body-' | append: section_settings.item_text_letter_spacing | append: ')'
  endif
%}

<div class="section-background{% if section_settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"></div>

<div
  class="section section--{{ section_settings.section_width }} spacing-style ppw-timeline-section{% if section_settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
  style="
    --timeline-line: {{ section_settings.line_color | default: '#e8821a' }};
    --timeline-card-bg: {{ section_settings.card_background | default: '#252522' }};
    --timeline-card-border: {{ section_settings.card_border_color | default: '#e8821a' }};
    --timeline-card-border-width: {{ section_settings.card_border_width }}px;
    --timeline-year-color: {{ section_settings.year_color | default: '#e8821a' }};
    --timeline-heading-color: {{ section_settings.item_heading_color | default: '#ffffff' }};
    --timeline-text-color: {{ section_settings.item_text_color | default: '#ffffffb3' }};
    --timeline-icon-bg: {{ section_settings.icon_background | default: '#1c1c1a' }};
    --timeline-caption-color: {{ section_settings.caption_color | default: '#e8821a' }};
    --timeline-title-color: {{ section_settings.heading_color | default: '#ffffff' }};
    {% if caption_letter_spacing != blank %}
      --timeline-caption-letter-spacing: {{ caption_letter_spacing }};
    {% endif %}
    {% if heading_letter_spacing != blank %}
      --timeline-heading-letter-spacing: {{ heading_letter_spacing }};
    {% endif %}
    {% if year_letter_spacing != blank %}
      --timeline-year-letter-spacing: {{ year_letter_spacing }};
    {% endif %}
    {% if item_heading_letter_spacing != blank %}
      --timeline-item-heading-letter-spacing: {{ item_heading_letter_spacing }};
    {% endif %}
    {% if item_text_letter_spacing != blank %}
      --timeline-text-letter-spacing: {{ item_text_letter_spacing }};
    {% endif %}
    {% render 'gap-style', value: section_settings.gap %}
    {% render 'spacing-style', settings: section_settings %}
    {% render 'border-override', settings: section_settings %}
  "
>
  {% if section_settings.caption != blank or section_settings.heading != blank %}
    <div class="ppw-timeline__intro">
      {% if section_settings.caption != blank %}
        <p class="ppw-timeline__caption">{{ section_settings.caption }}</p>
      {% endif %}
      {% if section_settings.heading != blank %}
        <h2 class="ppw-timeline__heading">{{ section_settings.heading }}</h2>
      {% endif %}
    </div>
  {% endif %}

  <div class="ppw-timeline border-style">
    {% content_for 'blocks' %}
  </div>
</div>

{% stylesheet %}
  .ppw-timeline-section {
    row-gap: 4rem;
  }

  .ppw-timeline-section.section--page-width > * {
    grid-column: 2;
  }

  .ppw-timeline-section.section--full-width > * {
    grid-column: 1 / -1;
  }

  .ppw-timeline__intro {
    text-align: center;
  }

  .ppw-timeline__caption {
    margin: 0 0 0.75rem;
    font-family: var(--font-heading--family);
    font-size: 0.9rem;
    letter-spacing: var(--timeline-caption-letter-spacing, 0.2em);
    text-transform: uppercase;
    color: var(--timeline-caption-color);
  }

  .ppw-timeline__heading {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: clamp(2.5rem, 5vw, 4rem);
    line-height: 1;
    letter-spacing: var(--timeline-heading-letter-spacing, normal);
    text-transform: uppercase;
    color: var(--timeline-title-color);
  }

  .ppw-timeline {
    --timeline-icon-size: 4rem;
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--gap, 3rem);
  }

  .ppw-timeline > * {
    width: 100%;
  }

  .ppw-timeline::before {
    content: '';
    position: absolute;
    inset-block: 0;
    inset-inline-start: 50%;
    width: 4px;
    background: var(--timeline-line);
    transform: translateX(-50%);
  }

  .ppw-timeline-item {
    display: grid;
    grid-template-columns: minmax(0, 1fr) var(--timeline-icon-size) minmax(0, 1fr);
    align-items: center;
    column-gap: 2rem;
    width: 100%;
    min-height: var(--timeline-icon-size);
    position: relative;
  }

  .ppw-timeline-item__card,
  .ppw-timeline-item__spacer {
    min-width: 0;
  }

  .ppw-timeline-item__card {
    grid-column: 1;
    grid-row: 1;
  }

  .ppw-timeline-item__spacer {
    grid-column: 3;
    grid-row: 1;
  }

  .ppw-timeline-item--right .ppw-timeline-item__card {
    grid-column: 3;
  }

  .ppw-timeline-item--right .ppw-timeline-item__spacer {
    grid-column: 1;
  }

  .ppw-timeline-item--left .ppw-timeline-item__card {
    text-align: end;
  }

  .ppw-timeline-item--right .ppw-timeline-item__card {
    text-align: start;
  }

  .ppw-timeline-item__card {
    border: var(--timeline-card-border-width) solid var(--timeline-card-border);
    background: var(--timeline-card-bg);
    padding: 1.5rem;
  }

  .ppw-timeline-item__year {
    margin: 0 0 0.5rem;
    font-family: var(--font-heading--family);
    font-size: 2rem;
    line-height: 1;
    letter-spacing: var(--timeline-year-letter-spacing, normal);
    color: var(--timeline-year-color);
  }

  .ppw-timeline-item__heading {
    margin: 0 0 0.75rem;
    font-family: var(--font-heading--family);
    font-size: 1.4rem;
    line-height: 1.1;
    letter-spacing: var(--timeline-item-heading-letter-spacing, normal);
    text-transform: uppercase;
    color: var(--timeline-heading-color);
  } 

  .ppw-timeline-item__text,
  .ppw-timeline-item__text p {
    margin: 0;
    color: var(--timeline-text-color);
    line-height: 1.6;
    letter-spacing: var(--timeline-text-letter-spacing, normal);
  }

  .ppw-timeline-item__icon {
    position: absolute;
    inset-inline-start: 50%;
    inset-block-start: 50%;
    transform: translate(-50%, -50%);
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: var(--timeline-icon-size);
    height: var(--timeline-icon-size);
    border: 4px solid var(--timeline-line);
    border-radius: 50%;
    background: var(--timeline-icon-bg);
    font-size: 1.5rem;
    z-index: 1;
  }

  @media screen and (max-width: 749px) {
    .ppw-timeline {
      --timeline-icon-size: 3rem;
    }

    .ppw-timeline::before {
      inset-inline-start: calc(var(--timeline-icon-size) / 2);
    }

    .ppw-timeline-item,
    .ppw-timeline-item--right {
      grid-template-columns: var(--timeline-icon-size) minmax(0, 1fr);
      column-gap: 1rem;
    }

    .ppw-timeline-item__card,
    .ppw-timeline-item--left .ppw-timeline-item__card,
    .ppw-timeline-item--right .ppw-timeline-item__card {
      grid-column: 2;
      grid-row: 1;
      text-align: start;
      padding: 1rem;
    }

    .ppw-timeline-item__spacer {
      display: none;
    }

    .ppw-timeline-item__icon {
      position: relative;
      inset-block: auto;
      inset-inline: auto;
      grid-column: 1;
      grid-row: 1;
      justify-self: center;
      transform: none;
      font-size: 1.25rem;
    }
  }
{% endstylesheet %}

