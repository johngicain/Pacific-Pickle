{%- doc -%}
  Accessible tabs with per-tab block settings.

  @param {string} items - Rendered tab items from content_for
  @param {object} settings - Section or block settings
  @param {string} id - Unique id for this tabs instance
  @param {string} [attributes] - Optional attributes for the component wrapper
{%- enddoc -%}

<script
  src="{{ 'tabs.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{% liquid
  assign tab_style = settings.tab_style | default: 'underline'
  assign tab_alignment = settings.tab_alignment | default: 'start'
  assign type_preset = settings.type_preset | default: 'h6'
  if type_preset == blank
    assign type_preset = 'h6'
  endif
  if type_preset == 'custom'
    assign preset_name = 'body'
  else
    assign preset_name = type_preset
  endif
%}

{% render 'tabs-styles' %}

<tabs-component
  class="tabs tabs--{{ tab_style }} tabs--align-{{ tab_alignment }}"
  style="
    --tabs-font-family: {% if settings.font != blank %}{{ settings.font }}{% else %}var(--font-{{ preset_name }}--family){% endif %};
    --tabs-font-style: {% if settings.font != blank %}{{ settings.font | replace: 'family', 'style' }}{% else %}var(--font-{{ preset_name }}--style){% endif %};
    --tabs-font-weight: {% if settings.weight != blank %}{{ settings.weight }}{% elsif settings.font != blank %}{{ settings.font | replace: 'family', 'weight' }}{% else %}var(--font-{{ preset_name }}--weight){% endif %};
    --tabs-font-size: {% if settings.font_size != blank %}{{ settings.font_size }}{% else %}var(--font-{{ preset_name }}--size){% endif %};
    --tabs-line-height: var(--font-{{ preset_name }}--line-height);
    --tabs-letter-spacing: var(--font-{{ preset_name }}--letter-spacing);
    --tabs-font-case: {% if settings.case != blank %}{{ settings.case }}{% else %}var(--font-{{ preset_name }}--case){% endif %};
    --tabs-gap: {{ settings.gap }}px;
    --tabs-content-padding: {{ settings.content_padding }}px;
    {% if settings.panel_max_width == 'custom' %}--tabs-panel-max-width: {{ settings.panel_custom_max_width }}px;{% endif %}
    {% if settings.text_color != blank %}--tabs-text: {{ settings.text_color }};{% endif %}
    {% if settings.active_color != blank %}--tabs-active: {{ settings.active_color }};{% endif %}
    {% if settings.indicator_color != blank %}--tabs-indicator: {{ settings.indicator_color }};{% endif %}
  "
  {{ attributes }}
>
  {% if settings.heading != blank %}
    <h2
      class="tabs__heading"
      style="--tabs-heading-align: {{ settings.heading_alignment | default: 'left' }};"
    >
      {{ settings.heading }}
    </h2>
  {% endif %}

  {% if items != blank %}
    <div
      class="tabs__layout"
      role="tablist"
      aria-label="{{ 'accessibility.tabs' | t }}"
      id="tablist-{{ id }}"
      ref="tablist"
      on:click="/selectTab"
      on:keydown="/onKeyDown"
    >
      {{ items }}
    </div>
  {% elsif request.design_mode or request.visual_preview_mode %}
    <p class="tabs__empty">{{ 'accessibility.tabs' | t }}</p>
  {% endif %}
</tabs-component>
