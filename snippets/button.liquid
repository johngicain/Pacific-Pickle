{%- doc -%}
  Intended for use in a block similar to the button block.

  @param {string} link - link to render
  @param {object} [block] - The block

  @example
  {% render 'button', link: '/collections/all' %}
{%- enddoc -%}

{% liquid
  assign block_settings = block.settings
  assign show_caret = false
  if block_settings.show_caret and block_settings.style_class == 'button-unstyled'
    assign show_caret = true
  endif
  assign link_icon = block_settings.link_icon | default: 'caret'
%}
{% render 'button-custom-styles', block_settings: block_settings, block_id: block.id %}

<a
  {% if link == blank %}
    role="link"
    aria-disabled="true"
  {% else %}
    href="{{ link }}"
  {% endif %}
  class="
    size-style
    {{ block_settings.style_class }}
    {{ block_settings.style_class }}--{{ block.id }}
    {% if block_settings.box_shadow and block_settings.style_class != 'button-unstyled' %}button--box-shadow{% endif %}
    {% if block_settings.reveal_on_hover %}button--reveal-on-hover{% endif %}
    {% if show_caret %}button-unstyled--with-icon{% endif %}
  "
  style="{% render 'size-style', settings: block_settings %}"
  {%- if block_settings.open_in_new_tab -%}
    target="_blank"
    rel="noopener noreferrer"
  {%- endif -%}
  {{ block.shopify_attributes }}
>
  {{ block_settings.label }}
  {%- if show_caret -%}
    {%- if link_icon == 'external_link' -%}
      <span class="svg-wrapper icon-external-link" aria-hidden="true">
        {{- 'icon-external-link.svg' | inline_asset_content -}}
      </span>
    {%- else -%}
      <span class="svg-wrapper icon-caret" aria-hidden="true">
        {{- 'icon-caret.svg' | inline_asset_content -}}
      </span>
    {%- endif -%}
  {%- endif -%}
</a>

{% stylesheet %}
  .button-unstyled--with-icon .icon-caret,
  .button-unstyled--with-icon .icon-external-link {
    width: var(--icon-size-xs);
    height: var(--icon-size-xs);
  }

  .button-unstyled--with-icon .icon-caret svg,
  .button-unstyled--with-icon .icon-external-link svg {
    width: var(--icon-size-xs);
    height: var(--icon-size-xs);
  }

  .button-unstyled--with-icon .icon-caret svg {
    transform: rotate(-90deg);
  }
{% endstylesheet %}
