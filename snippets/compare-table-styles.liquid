{% doc %}
Styles for the compare table component.
@example
{% render 'compare-table-styles' %}
{% enddoc %}

{% stylesheet %}
  .ppw-compare {
    flex: 1;
    width: 100%;
    overflow-x: auto;
  }

  .ppw-compare__heading {
    margin: 0 0 1.5rem;
    text-align: var(--compare-heading-align, center);
    font-family: var(--font-heading--family);
    font-size: clamp(2rem, 5vw, 3.5rem);
    line-height: 1;
    text-transform: uppercase;
  }

  .ppw-compare table {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--font-body--family);
    border: var(--compare-border-width, 2px) var(--compare-border-style, solid) var(--compare-border, #1c1c1a);
  }

  @media screen and (min-width: 750px) {
    .ppw-compare table {
      table-layout: fixed;
    }

    .ppw-compare th:first-child,
    .ppw-compare td:first-child {
      width: var(--compare-feature-max-width, 25%);
      max-width: var(--compare-feature-max-width, 25%);
      overflow-wrap: anywhere;
    }

    .ppw-compare th:not(:first-child),
    .ppw-compare td:not(:first-child) {
      width: calc((100% - var(--compare-feature-max-width, 25%)) / 2);
    }
  }

  .ppw-compare th,
  .ppw-compare td {
    padding: 14px 16px;
    text-align: var(--compare-cell-align, left);
    border-bottom: 1px solid var(--compare-border, #1c1c1a);
    font-family: var(--compare-cell-font-family, inherit);
    font-style: var(--compare-cell-font-style, inherit);
    font-weight: var(--compare-cell-font-weight, inherit);
    font-size: var(--compare-cell-font-size, 0.9375rem);
    line-height: var(--compare-cell-line-height, 1.4);
    letter-spacing: var(--compare-cell-letter-spacing, inherit);
    text-transform: var(--compare-cell-text-transform, none);
    color: var(--compare-cell-color, inherit);
  }

  .ppw-compare thead th {
    background: var(--compare-cell-bg, var(--compare-header-bg, #3d6b35));
    color: var(--compare-cell-color, var(--compare-header-text, #ffffff));
    text-align: var(--compare-cell-align, left);
    font-family: var(--compare-header-font-family, var(--font-heading--family));
    font-style: var(--compare-header-font-style, normal);
    font-weight: var(--compare-header-font-weight, inherit);
    font-size: var(--compare-header-font-size, 0.8125rem);
    line-height: var(--compare-header-line-height, 1.4);
    letter-spacing: var(--compare-header-letter-spacing, 0.08em);
    text-transform: var(--compare-header-text-transform, uppercase);
    border-bottom-width: var(--compare-header-border-width, 1px);
    border-bottom-style: var(--compare-header-border-style, solid);
    border-bottom-color: var(--compare-header-border, var(--compare-border, #1c1c1a));
  }

  .ppw-compare tbody tr:nth-child(even) th,
  .ppw-compare tbody tr:nth-child(even) td {
    background: var(--compare-cell-bg, var(--compare-stripe, #f0ead8));
  }

  .ppw-compare tbody tr:nth-child(odd) th,
  .ppw-compare tbody tr:nth-child(odd) td {
    background: var(--compare-cell-bg, var(--compare-row, #ffffff));
  }

  .ppw-compare tbody tr:last-child th,
  .ppw-compare tbody tr:last-child td {
    border-bottom: none;
  }

  .ppw-compare .ppw-compare__ours {
    font-weight: var(--compare-cell-font-weight, 600);
    color: var(--compare-cell-color, var(--compare-ours, #3d6b35));
  }

  .ppw-compare tbody th {
    font-weight: var(--compare-cell-font-weight, 600);
    text-transform: var(--compare-cell-text-transform, uppercase);
    letter-spacing: var(--compare-cell-letter-spacing, 0.04em);
    font-size: var(--compare-cell-font-size, 0.8125rem);
  }
{% endstylesheet %}
