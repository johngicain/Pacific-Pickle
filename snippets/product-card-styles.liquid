{%- doc -%}
  Product card layout styles. Kept in a standalone snippet so empty filtered grids
  can preload the styles before facets morph product cards into the section.

  @example
  {% render 'product-card-styles' %}
{%- enddoc -%}

{% stylesheet %}
  .product-grid__card.product-grid__card {
    display: flex;
    flex-flow: column nowrap;
    gap: var(--product-card-gap);
    align-items: var(--product-card-alignment);
    text-decoration: none;
    color: var(--color, var(--color-foreground));
    padding-block: var(--padding-block-start) var(--padding-block-end);
    padding-inline: var(--padding-inline-start) var(--padding-inline-end);
    overflow: hidden;
  }

  .product-grid__card .group-block > * {
    @media screen and (max-width: 749px) {
      flex-direction: column;
    }
  }

  /* Collection and product list cards have equal heights */
  :is(.product-grid__item, .resource-list__item) .product-card {
    display: grid;
    height: 100%;
  }

  /* Product card title truncation - applied on mobile regardless of view */
  @media screen and (max-width: 749px) {
    :is(.product-card, .product-grid__card) :is(h4, .h4) {
      display: -webkit-box;
      -webkit-box-orient: vertical;
      overflow: hidden;
      text-overflow: ellipsis;
      -webkit-line-clamp: 1;
      line-clamp: 1;
    }
  }

  .product-card__placeholder-image svg {
    height: 100%;
  }

  .product-card__content slideshow-component {
    --cursor: pointer;
  }

  @media screen and (max-width: 749px) {
    .product-card slideshow-arrows .slideshow-control {
      display: none;
    }
  }

  .product-grid .product-card slideshow-arrows {
    display: none;
  }

  .product-grid .product-card .quantity-selector-wrapper,
  .product-grid .product-card quantity-selector-component {
    display: none;
  }

  .product-grid .product-card .buy-buttons-block,
  .product-grid .product-card .product-form-buttons,
  .product-grid .product-card .add-to-cart-button {
    width: 100%;
  }

  .product-grid .product-card .buy-buttons-block {
    margin-block-start: auto;
  }

  .product-grid .product-card .add-to-cart-button {
    /* min-height: 2.75rem; */
    height: auto;
    letter-spacing: var(--add-to-cart-letter-spacing, 0.08em);
  }

  .product-grid .product-card .add-to-cart-icon {
    display: var(--add-to-cart-icon-display, flex);
  }

  .product-grid .product-card .add-to-cart-button--hide-icon .add-to-cart-icon {
    display: none;
  }

  .product-grid .product-card .add-to-cart-text {
    font-family: var(--add-to-cart-font-family, inherit);
    font-weight: var(--add-to-cart-font-weight, inherit);
    font-size: var(--add-to-cart-font-size, inherit);
    letter-spacing: var(--add-to-cart-letter-spacing, 0.08em);
    text-transform: var(--add-to-cart-font-case, inherit);
  }

  .product-grid .product-card .card-gallery .product-card-tag {
    position: absolute;
    inset-block-start: var(--padding-sm);
    inset-inline-start: var(--padding-sm);
    z-index: var(--layer-raised);
    pointer-events: none;
    color: var(--product-card-tag-color, #ffffff);
    background-color: var(--product-card-tag-background, #1c1c1a);
    font-size: 14px;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 0.35em 0.6em;
  }

  .product-grid .product-card .card-gallery .product-card-tag:empty {
    display: none;
  }

  .product-grid .product-card .group-block {
    width: 100%;
  }

  .product-grid .product-card .group-block .text-block {
    min-width: 0;
    max-width: 100%;
    flex: 1;
  }

  .product-grid .product-card .group-block .text-block p {
    display: -webkit-box;
    -webkit-line-clamp: 1;
    line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-overflow: ellipsis;
    max-inline-size: 100%;
  }

  .product-grid .product-grid__card > .text-block {
    min-width: 0;
    max-width: 100%;
  }

  .product-grid .product-grid__card > .text-block > *:not(:first-child) {
    display: none;
  }

  .product-grid .product-grid__card > .text-block > :first-child {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-overflow: ellipsis;
    -webkit-line-clamp: 1;
    line-clamp: 1;
    max-inline-size: 100%;
  }

  .product-grid .product-card .product-information-details {
    display: flex;
    flex-direction: column;
    flex-shrink: 0;
    min-width: 0;
    max-width: 100%;
    width: 100%;
    overflow: visible;
    padding-inline: 12px;
  }

  .product-grid .product-card .product-information-details__items {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--product-information-details-gap, 4px);
    list-style: none;
    margin: 0;
    padding: 0;
    width: 100%;
  }

  .product-grid .product-card .product-information-details__item {
    display: inline-flex;
    align-items: center;
    list-style: none;
    width: auto;
    max-width: 100%;
    margin: 0;
  }
{% endstylesheet %}
