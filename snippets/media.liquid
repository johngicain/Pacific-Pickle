{%- doc -%}
  Renders media block contents (used in _media and _media-without-appearance blocks)

  @param {object} [block] - The block object
  @param {boolean} [unset_image_tag] - if true, ignores the image focal point in the image
  @param {object} [fallback_image] - Image to render when the block image setting is blank
{%- enddoc -%}

{% liquid
  assign block_settings = block.settings
  assign media_image = fallback_image
  if block_settings.image != blank
    assign media_image = block_settings.image
  endif
  assign show_image = false
  assign show_video = false
  assign show_text = false
  assign show_tag = false
  assign tag_id = block.id | append: '-tag'

  if block_settings.background_color != blank
    render 'contrast-override', background_color: block_settings.background_color, section_id: block.id
  endif

  if block_settings.media_type == 'image'
    assign show_image = true
  endif

  if block_settings.media_type == 'video'
    assign show_video = true
  endif

  if block_settings.heading != blank or block_settings.subheading != blank
    assign show_text = true
  endif

  if block_settings.tag_heading != blank or block_settings.tag_subheading != blank
    assign show_tag = true
  endif

  assign tag_position = block_settings.tag_position | default: 'top-left'
  assign text_direction = block_settings.text_direction | default: 'column'
  assign text_alignment = block_settings.text_alignment | default: 'flex-start'
  assign text_position = block_settings.text_position | default: 'flex-end'
  assign heading_font = block_settings.heading_font
  assign heading_font_weight = block_settings.heading_font_weight
  assign heading_letter_spacing = block_settings.heading_letter_spacing
  assign heading_letter_spacing_custom = block_settings.heading_letter_spacing_custom
  assign subheading_family = block_settings.subheading_family
  assign subheading_weight = block_settings.subheading_weight
  assign subheading_letter_spacing = block_settings.subheading_letter_spacing
  assign subheading_letter_spacing_custom = block_settings.subheading_letter_spacing_custom

  if heading_letter_spacing == 'custom'
    assign heading_letter_spacing_value = heading_letter_spacing_custom | append: 'px'
  elsif heading_letter_spacing != blank
    assign heading_letter_spacing_value = 'var(--letter-spacing--heading-' | append: heading_letter_spacing | append: ')'
  endif

  if subheading_letter_spacing == 'custom'
    assign subheading_letter_spacing_value = subheading_letter_spacing_custom | append: 'px'
  elsif subheading_letter_spacing != blank
    assign subheading_letter_spacing_value = 'var(--letter-spacing--body-' | append: subheading_letter_spacing | append: ')'
  endif

  if text_direction == 'row'
    assign text_justify = text_alignment
    assign text_align_items = text_position
  else
    assign text_justify = text_position
    assign text_align_items = text_alignment
  endif

  if text_align_items == 'space-between'
    assign text_align_items = 'stretch'
  endif

  case text_alignment
    when 'center'
      assign text_text_align = 'center'
    when 'flex-end'
      assign text_text_align = 'end'
    else
      assign text_text_align = 'start'
  endcase

  if show_tag and block_settings.tag_background_color != blank
    render 'contrast-override', background_color: block_settings.tag_background_color, border_color: block_settings.tag_border_color, section_id: tag_id, preset: 'ui'
  endif
%}

<div
  class="
    media-block
    spacing-style
    {% if block_settings.background_color != blank %} color-custom-{{ block.id }}{% endif %}
    {% if show_image and block_settings.image_position == 'contain' or show_video and block_settings.video_position == 'contain' %}
      media-block--contain
    {% endif %}
    {% if show_tag %}media-block--has-tag{% endif %}
    {% if show_text %}media-block--has-text{% endif %}
  "
  style="
    {% render 'border-override', settings: block_settings %}
    {% render 'spacing-style', settings: block_settings %}
    --image-position: {{ block_settings.image_position }};
    --video-position: {{ block_settings.video_position }};
    {% if show_text %}
      --media-block-text-direction: {{ text_direction }};
      --media-block-text-justify: {{ text_justify }};
      --media-block-text-align: {{ text_align_items }};
      --media-block-text-text-align: {{ text_text_align }};
      {% if heading_font != blank %}
        --media-block-heading-font: {{ heading_font }};
      {% endif %}
      {% if heading_font_weight != blank %}
        --media-block-heading-font-weight: {{ heading_font_weight }};
      {% endif %}
      {% if block_settings.heading_font_size != blank %}
        --media-block-heading-font-size: {{ block_settings.heading_font_size }};
      {% endif %}
      {% if block_settings.heading_text_color != blank %}
        --media-block-heading-color: {{ block_settings.heading_text_color }};
      {% endif %}
      {% if heading_letter_spacing_value != blank %}
        --media-block-heading-letter-spacing: {{ heading_letter_spacing_value }};
      {% endif %}
      {% if subheading_family != blank %}
        --media-block-subheading-font: {{ subheading_family }};
      {% endif %}
      {% if subheading_weight != blank %}
        --media-block-subheading-font-weight: {{ subheading_weight }};
      {% endif %}
      {% if block_settings.subheading_font_size != blank %}
        --media-block-subheading-font-size: {{ block_settings.subheading_font_size }};
      {% endif %}
      {% if block_settings.subheading_text_color != blank %}
        --media-block-subheading-color: {{ block_settings.subheading_text_color }};
      {% endif %}
      {% if subheading_letter_spacing_value != blank %}
        --media-block-subheading-letter-spacing: {{ subheading_letter_spacing_value }};
      {% endif %}
    {% endif %}
  "
  {{ block.shopify_attributes }}
>
  {%- if show_image -%}
    {% capture image_tag %}
      {% if media_image != blank %}
        {% render 'image',
          image: media_image,
          class: 'media-block__media border-style',
          unset_image_tag: unset_image_tag
        %}
      {% else %}
        <div class="media-block__media border-style">
          {{ 'detailed-apparel-1' | placeholder_svg_tag: 'media-block__placeholder' }}
        </div>
      {% endif %}
    {% endcapture %}

    {% if block_settings.link != blank %}
      <a
        href="{{ block_settings.link }}"
        class="media-block__media-link"
      >
        {{ image_tag }}
      </a>
    {% else %}
      {{ image_tag }}
    {% endif %}
  {%- elsif show_video -%}
    {% render 'video',
      video: block_settings.video,
      video_autoplay: block_settings.video_autoplay,
      video_loop: block_settings.video_loop,
      video_class: 'media-block__media media-block__media--video border-style'
    %}
  {%- else -%}
    <div class="media-block__media border-style">
      {{ 'hero-apparel-3' | placeholder_svg_tag }}
    </div>
  {%- endif -%}

  {%- if show_text -%}
    <div class="media-block__text">
      {%- if block_settings.heading != blank -%}
        <p class="
          media-block__heading
          h3
          {% if heading_font != blank %}media-block__heading--custom-font{% endif %}
          {% if heading_font_weight != blank %}media-block__heading--custom-weight{% endif %}
          {% if block_settings.heading_font_size != blank %}media-block__heading--custom-size{% endif %}
          {% if block_settings.heading_text_color != blank %}media-block__heading--custom-color{% endif %}
          {% if heading_letter_spacing_value != blank %}media-block__heading--custom-letter-spacing{% endif %}
        ">
          {{ block_settings.heading }}
        </p>
      {%- endif -%}
      {%- if block_settings.subheading != blank -%}
        <p class="
          media-block__subheading
          paragraph
          {% if subheading_family != blank %}media-block__subheading--custom-font{% endif %}
          {% if subheading_weight != blank %}media-block__subheading--custom-weight{% endif %}
          {% if block_settings.subheading_font_size != blank %}media-block__subheading--custom-size{% endif %}
          {% if block_settings.subheading_text_color != blank %}media-block__subheading--custom-color{% endif %}
          {% if subheading_letter_spacing_value != blank %}media-block__subheading--custom-letter-spacing{% endif %}
        ">
          {{ block_settings.subheading }}
        </p>
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- if show_tag -%}
    <div
      class="
        media-block__tag
        media-block__tag--{{ tag_position }}
        {% if block_settings.tag_background_color != blank %}color-custom-{{ tag_id }}{% endif %}
      "
      style="
        --media-block-tag-border-width: {% if block_settings.tag_border == 'solid' %}{{ block_settings.tag_border_width }}px{% else %}0px{% endif %};
        --media-block-tag-border-style: {{ block_settings.tag_border }};
        --media-block-tag-border-color: {% if block_settings.tag_border_color != blank %}{{ block_settings.tag_border_color }}{% else %}rgb(var(--color-border-rgb) / {{ block_settings.tag_border_opacity | divided_by: 100.0 }}){% endif %};
        --media-block-tag-border-radius: {{ block_settings.tag_border_radius }}px;
        --media-block-tag-padding-block-start: {{ block_settings.tag_padding_block_start }}px;
        --media-block-tag-padding-block-end: {{ block_settings.tag_padding_block_end }}px;
        --media-block-tag-padding-inline-start: {{ block_settings.tag_padding_inline_start }}px;
        --media-block-tag-padding-inline-end: {{ block_settings.tag_padding_inline_end }}px;
        {% if block_settings.tag_heading_font_size != blank %}
          --media-block-tag-heading-font-size: {{ block_settings.tag_heading_font_size }};
        {% endif %}
        {% if block_settings.tag_heading_text_color != blank %}
          --media-block-tag-heading-color: {{ block_settings.tag_heading_text_color }};
        {% endif %}
        {% if block_settings.tag_subheading_font_size != blank %}
          --media-block-tag-subheading-font-size: {{ block_settings.tag_subheading_font_size }};
        {% endif %}
        {% if block_settings.tag_subheading_text_color != blank %}
          --media-block-tag-subheading-color: {{ block_settings.tag_subheading_text_color }};
        {% endif %}
        --media-block-tag-heading-align: {{ block_settings.tag_heading_alignment | default: 'left' }};
        --media-block-tag-subheading-align: {{ block_settings.tag_subheading_alignment | default: 'left' }};
      "
    >
      {%- if block_settings.tag_subheading != blank -%}
        <p
          class="
            media-block__tag-subheading
            {{ block_settings.tag_subheading_preset }}
            {% if block_settings.tag_subheading_font_size != blank %}media-block__tag-subheading--custom-size{% endif %}
            {% if block_settings.tag_subheading_text_color != blank %}media-block__tag-subheading--custom-color{% endif %}
          "
          style="
            {% if block_settings.tag_subheading_font_size != blank %}font-size: {{ block_settings.tag_subheading_font_size }};{% endif %}
            {% if block_settings.tag_subheading_text_color != blank %}color: {{ block_settings.tag_subheading_text_color }};{% endif %}
            text-align: {{ block_settings.tag_subheading_alignment | default: 'left' }};
          "
        >
          {{ block_settings.tag_subheading }}
        </p>
      {%- endif -%}
      {%- if block_settings.tag_heading != blank -%}
        <p
          class="
            media-block__tag-heading
            {{ block_settings.tag_heading_preset }}
            {% if block_settings.tag_heading_font_size != blank %}media-block__tag-heading--custom-size{% endif %}
            {% if block_settings.tag_heading_text_color != blank %}media-block__tag-heading--custom-color{% endif %}
          "
          style="
            {% if block_settings.tag_heading_font_size != blank %}font-size: {{ block_settings.tag_heading_font_size }};{% endif %}
            {% if block_settings.tag_heading_text_color != blank %}color: {{ block_settings.tag_heading_text_color }};{% endif %}
            text-align: {{ block_settings.tag_heading_alignment | default: 'left' }};
          "
        >
          {{ block_settings.tag_heading }}
        </p>
      {%- endif -%}
    </div>
  {%- endif -%}
</div>

{% stylesheet %}
  .media-block {
    overflow: hidden;
    position: relative;

    @media screen and (min-width: 750px) {
      min-height: var(--media-height);
    }
  }

  .media-block.media-block--has-tag {
    overflow: visible !important;
    z-index: 1;
  }

  .media-block--has-tag .media-block__media {
    border-radius: var(--border-radius, 0);
  }

  .media-block__tag {
    position: absolute;
    z-index: 2;
    display: flex;
    flex-direction: column;
    width: max-content;
    max-width: min(12rem, 80%);
    border-width: var(--media-block-tag-border-width, 0);
    border-style: var(--media-block-tag-border-style, none);
    border-color: var(--media-block-tag-border-color, transparent);
    border-radius: var(--media-block-tag-border-radius, 0);
    padding-block: var(--media-block-tag-padding-block-start, 0) var(--media-block-tag-padding-block-end, 0);
    padding-inline: var(--media-block-tag-padding-inline-start, 0) var(--media-block-tag-padding-inline-end, 0);
  }

  .media-block__tag--top-left {
    top: 0;
    left: 0;
    translate: -25% -25%;
  }

  .media-block__tag--top-right {
    top: 0;
    right: 0;
    translate: 25% -25%;
  }

  .media-block__tag--bottom-left {
    bottom: 0;
    left: 0;
    translate: -25% 25%;
  }

  .media-block__tag--bottom-right {
    bottom: 0;
    right: 0;
    translate: 25% 25%;
  }

  .media-block__tag-heading,
  .media-block__tag-subheading {
    margin: 0;
    width: 100%;
  }

  .media-block .media-block__tag-heading {
    text-align: var(--media-block-tag-heading-align, left);
  }

  .media-block .media-block__tag-subheading {
    text-align: var(--media-block-tag-subheading-align, left);
  }

  .media-block .media-block__tag-heading--custom-size,
  .media-block .media-block__tag-heading--custom-size.h4,
  .media-block .media-block__tag-heading--custom-size.h5,
  .media-block .media-block__tag-heading--custom-size.h6,
  .media-block .media-block__tag-heading--custom-size.paragraph,
  .media-block .media-block__tag-heading--custom-size.paragraph:not(.button) {
    font-size: var(--media-block-tag-heading-font-size);
  }

  .media-block .media-block__tag-heading--custom-color,
  .media-block .media-block__tag-heading--custom-color.h4,
  .media-block .media-block__tag-heading--custom-color.h5,
  .media-block .media-block__tag-heading--custom-color.h6,
  .media-block .media-block__tag-heading--custom-color.paragraph,
  .media-block .media-block__tag-heading--custom-color.paragraph:not(.button) {
    color: var(--media-block-tag-heading-color);
  }

  .media-block .media-block__tag-subheading--custom-size,
  .media-block .media-block__tag-subheading--custom-size.h4,
  .media-block .media-block__tag-subheading--custom-size.h5,
  .media-block .media-block__tag-subheading--custom-size.h6,
  .media-block .media-block__tag-subheading--custom-size.paragraph,
  .media-block .media-block__tag-subheading--custom-size.paragraph:not(.button) {
    font-size: var(--media-block-tag-subheading-font-size);
  }

  .media-block .media-block__tag-subheading--custom-color,
  .media-block .media-block__tag-subheading--custom-color.h4,
  .media-block .media-block__tag-subheading--custom-color.h5,
  .media-block .media-block__tag-subheading--custom-color.h6,
  .media-block .media-block__tag-subheading--custom-color.paragraph,
  .media-block .media-block__tag-subheading--custom-color.paragraph:not(.button) {
    color: var(--media-block-tag-subheading-color);
  }

  .media-block__text {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: flex;
    flex-direction: var(--media-block-text-direction, column);
    justify-content: var(--media-block-text-justify, flex-end);
    align-items: var(--media-block-text-align, flex-start);
    gap: var(--padding-xs);
    padding: var(--padding-lg);
    pointer-events: none;
    text-align: var(--media-block-text-text-align, start);
  }

  .media-block__heading,
  .media-block__subheading {
    margin: 0;
    max-width: 100%;
  }

  .media-block .media-block__heading--custom-font,
  .media-block .media-block__heading--custom-font.h3 {
    font-family: var(--media-block-heading-font);
  }

  .media-block .media-block__heading--custom-weight,
  .media-block .media-block__heading--custom-weight.h3 {
    font-weight: var(--media-block-heading-font-weight);
  }

  .media-block .media-block__heading--custom-size {
    font-size: var(--media-block-heading-font-size);
  }

  .media-block .media-block__heading--custom-color {
    color: var(--media-block-heading-color);
  }

  .media-block .media-block__heading--custom-letter-spacing,
  .media-block .media-block__heading--custom-letter-spacing.h3 {
    letter-spacing: var(--media-block-heading-letter-spacing);
  }

  .media-block .media-block__subheading--custom-font,
  .media-block .media-block__subheading--custom-font.paragraph,
  .media-block .media-block__subheading--custom-font.paragraph:not(.button) {
    font-family: var(--media-block-subheading-font);
  }

  .media-block .media-block__subheading--custom-weight,
  .media-block .media-block__subheading--custom-weight.paragraph,
  .media-block .media-block__subheading--custom-weight.paragraph:not(.button) {
    font-weight: var(--media-block-subheading-font-weight);
  }

  .media-block .media-block__subheading--custom-size {
    font-size: var(--media-block-subheading-font-size);
  }

  .media-block .media-block__subheading--custom-color {
    color: var(--media-block-subheading-color);
  }

  .media-block .media-block__subheading--custom-letter-spacing,
  .media-block .media-block__subheading--custom-letter-spacing.paragraph,
  .media-block .media-block__subheading--custom-letter-spacing.paragraph:not(.button) {
    letter-spacing: var(--media-block-subheading-letter-spacing);
  }

  .media-block__media {
    height: var(--media-height-mobile, auto);
    object-fit: var(--image-position, 'cover');
    object-position: center center;
    width: 100%;

    @media screen and (min-width: 750px) {
      height: 100%;
      position: absolute;
    }
  }

  deferred-media[class].media-block__media
    :is(.deferred-media__poster-button img, .deferred-media__poster-button ~ video) {
    object-fit: var(--video-position, 'cover');
  }

  /* This is to support corner radius on video and align the video to the center of the block */
  .media-block__placeholder {
    height: 100%;
    width: 100%;
    object-fit: cover;
    object-position: center center;
    overflow: hidden;
    position: relative;
  }

  .media-block__media--video {
    display: flex;
    align-items: center;
    justify-content: center;

    @media screen and (max-width: 749px) {
      --media-height-mobile: auto;
    }
  }
{% endstylesheet %}
