{% doc %}
Renders the Pacific Pickle Works versus mass-market comparison table.
@param {object} [settings] - Compare table settings for heading and text typography, color, alignment, and limit content width
@example
{% render 'ppw-compare-table' %}
{% enddoc %}

<div
  style="
    {% render 'compare-table-header-style', settings: settings %}
    {% render 'compare-table-intro-style', settings: settings %}
    --compare-border-style: {{ settings.border | default: 'solid' }};
    --compare-feature-max-width: {{ settings.feature_max_width | default: 25 }}%;
  "
>
  <div class="ppw-compare-stack{% if settings.narrow_width %} ppw-compare-stack--narrow{% endif %}">
    {% if settings.heading != blank or settings.text != blank %}
      <div class="ppw-compare__intro{% if settings.intro_narrow_width or settings.narrow_width %} ppw-compare__intro--narrow{% endif %}">
        {% if settings.heading != blank %}
          <h2 class="ppw-compare__heading{% if settings.heading_narrow_width %} ppw-compare__heading--narrow{% endif %}">
            {{ settings.heading }}
          </h2>
        {% endif %}
        {% if settings.text != blank %}
          <div class="ppw-compare__text rte{% if settings.text_narrow_width %} ppw-compare__text--narrow{% endif %}">
            {{ settings.text }}
          </div>
        {% endif %}
      </div>
    {% endif %}
    <div class="ppw-compare{% if settings.narrow_width %} ppw-compare--narrow{% endif %}">
      <table>
    <thead>
      <tr>
        <th
          scope="col"
          style="
            --compare-cell-align: {{ settings.header_feature_alignment | default: 'left' }};
            {% if settings.header_feature_color != blank -%}
              --compare-cell-color: {{ settings.header_feature_color }};
            {% endif -%}
            {% if settings.header_feature_background != blank -%}
              --compare-cell-bg: {{ settings.header_feature_background }};
            {% endif -%}
          "
        >
          Feature
        </th>
        <th
          scope="col"
          style="
            --compare-cell-align: {{ settings.header_ours_alignment | default: 'left' }};
            {% if settings.header_ours_color != blank -%}
              --compare-cell-color: {{ settings.header_ours_color }};
            {% endif -%}
            {% if settings.header_ours_background != blank -%}
              --compare-cell-bg: {{ settings.header_ours_background }};
            {% endif -%}
          "
        >
          Pacific Pickle Works
        </th>
        <th
          scope="col"
          style="
            --compare-cell-align: {{ settings.header_theirs_alignment | default: 'left' }};
            {% if settings.header_theirs_color != blank -%}
              --compare-cell-color: {{ settings.header_theirs_color }};
            {% endif -%}
            {% if settings.header_theirs_background != blank -%}
              --compare-cell-bg: {{ settings.header_theirs_background }};
            {% endif -%}
          "
        >
          Mass-Market Brands
        </th>
      </tr>
    </thead>
    <tbody>
      <tr class="ppw-compare__row">
        <th scope="row">Ingredients</th>
        <td class="ppw-compare__ours">Real garlic, dill &amp; spices</td>
        <td>Artificial flavors &amp; colors</td>
      </tr>
      <tr class="ppw-compare__row">
        <th scope="row">Vinegar</th>
        <td class="ppw-compare__ours">Organic distilled vinegar</td>
        <td>Conventional vinegar</td>
      </tr>
      <tr class="ppw-compare__row">
        <th scope="row">Packaging</th>
        <td class="ppw-compare__ours">Glass jar (no leaching)</td>
        <td>Plastic or tin</td>
      </tr>
      <tr class="ppw-compare__row">
        <th scope="row">Production</th>
        <td class="ppw-compare__ours">Hand-packed, small-batch</td>
        <td>Machine-filled, mass-produced</td>
      </tr>
      <tr class="ppw-compare__row">
        <th scope="row">Origin</th>
        <td class="ppw-compare__ours">Santa Barbara, CA since 2001</td>
        <td>Industrial facility, unknown origin</td>
      </tr>
      <tr class="ppw-compare__row">
        <th scope="row">Non-GMO</th>
        <td class="ppw-compare__ours">Project Verified</td>
        <td>Not verified</td>
      </tr>
      <tr class="ppw-compare__row">
        <th scope="row">Gluten-Free</th>
        <td class="ppw-compare__ours">Naturally gluten-free</td>
        <td>May contain shared equipment</td>
      </tr>
      <tr class="ppw-compare__row">
        <th scope="row">Flavor Variety</th>
        <td class="ppw-compare__ours">16+ bold California flavors</td>
        <td>3–5 generic options</td>
      </tr>
    </tbody>
  </table>
    </div>
  </div>
</div>

{% render 'compare-table-styles' %}
