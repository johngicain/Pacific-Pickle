{% doc %}
Renders the Pacific Pickle Works versus mass-market comparison table.
@param {object} [settings] - Compare table settings for header typography, color, and alignment
@example
{% render 'ppw-compare-table' %}
{% enddoc %}

<div
  class="ppw-compare"
  style="{% render 'compare-table-header-style', settings: settings %}"
>
  <table>
    <thead>
      <tr>
        <th
          scope="col"
          style="--compare-cell-align: {{ settings.header_feature_alignment | default: 'left' }}"
        >
          Feature
        </th>
        <th
          scope="col"
          style="--compare-cell-align: {{ settings.header_ours_alignment | default: 'left' }}"
        >
          Pacific Pickle Works
        </th>
        <th
          scope="col"
          style="--compare-cell-align: {{ settings.header_theirs_alignment | default: 'left' }}"
        >
          Mass-Market Brands
        </th>
      </tr>
    </thead>
    <tbody>
      <tr class="ppw-compare__row">
        <th scope="row">Ingredients</th>
        <td class="ppw-compare__ours">Real garlic, dill &amp; spices</td>
        <td>Artificial flavors &amp; colors</td>
      </tr>
      <tr class="ppw-compare__row">
        <th scope="row">Vinegar</th>
        <td class="ppw-compare__ours">Organic distilled vinegar</td>
        <td>Conventional vinegar</td>
      </tr>
      <tr class="ppw-compare__row">
        <th scope="row">Packaging</th>
        <td class="ppw-compare__ours">Glass jar (no leaching)</td>
        <td>Plastic or tin</td>
      </tr>
      <tr class="ppw-compare__row">
        <th scope="row">Production</th>
        <td class="ppw-compare__ours">Hand-packed, small-batch</td>
        <td>Machine-filled, mass-produced</td>
      </tr>
      <tr class="ppw-compare__row">
        <th scope="row">Origin</th>
        <td class="ppw-compare__ours">Santa Barbara, CA since 2001</td>
        <td>Industrial facility, unknown origin</td>
      </tr>
      <tr class="ppw-compare__row">
        <th scope="row">Non-GMO</th>
        <td class="ppw-compare__ours">Project Verified</td>
        <td>Not verified</td>
      </tr>
      <tr class="ppw-compare__row">
        <th scope="row">Gluten-Free</th>
        <td class="ppw-compare__ours">Naturally gluten-free</td>
        <td>May contain shared equipment</td>
      </tr>
      <tr class="ppw-compare__row">
        <th scope="row">Flavor Variety</th>
        <td class="ppw-compare__ours">16+ bold California flavors</td>
        <td>3–5 generic options</td>
      </tr>
    </tbody>
  </table>
</div>

{% render 'compare-table-styles' %}
