{% liquid
  assign block_settings = block.settings
  assign details_data = block_settings.details
  assign metafield_type = details_data.type
  assign details_string = details_data

  if metafield_type != blank and details_data.value != blank
    if metafield_type contains 'list.'
      assign details_string = details_data.value | join: '~~'
    else
      assign details_string = details_data.value
    endif
  endif

  assign details_string = details_string | replace: '</li>', '~~' | replace: '</p>', '~~'
  assign details_string = details_string | replace: '<br />', '~~' | replace: '<br/>', '~~' | replace: '<br>', '~~'
  assign details_string = details_string | newline_to_br | replace: '<br />', '~~' | strip_html
  assign detail_items = details_string | split: '~~'

  assign has_items = false
  for item in detail_items
    assign item_text = item | strip
    if item_text != blank
      assign has_items = true
    endif
  endfor

  assign show_placeholders = false
  if has_items == false
    if request.visual_preview_mode or request.design_mode
      assign show_placeholders = true
    endif
  endif

  assign heading = block_settings.heading | strip
  assign heading_preset = block_settings.heading_preset | default: 'h6'
  assign heading_classes = 'product-information-details__heading'
  assign heading_type = 'heading'
  if heading_preset == 'custom'
    assign heading_classes = heading_classes | append: ' custom-typography'
    if block_settings.heading_font_size != blank
      assign heading_classes = heading_classes | append: ' custom-font-size'
      assign heading_font_size_value = block_settings.heading_font_size | split: 'rem' | first | times: 1.0
      if heading_font_size_value >= 3
        assign heading_type = 'display'
      elsif heading_font_size_value >= 1.25
        assign heading_type = 'heading'
      else
        assign heading_type = 'body'
      endif
    endif
    if block_settings.heading_weight != blank
      assign heading_classes = heading_classes | append: ' custom-font-weight'
    endif
  elsif heading_preset != blank
    assign heading_classes = heading_classes | append: ' ' | append: heading_preset
  endif
  if block_settings.heading_weight != blank
    assign heading_classes = heading_classes | append: ' product-information-details__heading--weight'
  endif

  assign text_preset = block_settings.type_preset | default: 'custom'
  assign item_classes = 'product-information-details__item'
  assign text_type = 'body'
  if text_preset == 'custom'
    assign item_classes = item_classes | append: ' custom-typography'
    if block_settings.font_size != blank
      assign item_classes = item_classes | append: ' custom-font-size'
      assign font_size_value = block_settings.font_size | split: 'rem' | first | times: 1.0
      if font_size_value >= 3
        assign text_type = 'display'
      elsif font_size_value >= 1.25
        assign text_type = 'heading'
      endif
    endif
    if block_settings.weight != blank
      assign item_classes = item_classes | append: ' custom-font-weight'
    endif
  elsif text_preset != blank
    assign item_classes = item_classes | append: ' ' | append: text_preset
  endif
  if block_settings.enable_border
    assign item_classes = item_classes | append: ' border-style'
  endif

  case block_settings.alignment
    when 'center'
      assign align_items = 'center'
      assign text_align = 'center'
    when 'right'
      assign align_items = 'flex-end'
      assign text_align = 'end'
    else
      assign align_items = 'flex-start'
      assign text_align = 'start'
  endcase
%}

{% capture heading_style %}
  --product-information-details-heading-font: {{ block_settings.heading_font }};
  {%- if block_settings.heading_weight != blank -%}
    --product-information-details-heading-weight: {{ block_settings.heading_weight }};
    --font-weight: {{ block_settings.heading_weight }};
  {%- endif -%}
  {%- if heading_preset == 'custom' -%}
    --font-family: {{ block_settings.heading_font }};
    {%- if block_settings.heading_font_size != blank -%}
      --font-size: {{ block_settings.heading_font_size }};
    {%- endif -%}
    {%- if block_settings.heading_weight != blank -%}
      --font-weight: {{ block_settings.heading_weight }};
    {%- else -%}
      --font-weight: {{ block_settings.heading_font | replace: 'family', 'weight' }};
    {%- endif -%}
    --text-transform: {{ block_settings.heading_case }};
    --text-wrap: {{ block_settings.heading_wrap | default: 'pretty' }};
    --line-height: var(--line-height--{{ heading_type }}-{{ block_settings.heading_line_height }});
    --letter-spacing: var(--letter-spacing--{{ heading_type }}-{{ block_settings.heading_letter_spacing }});
  {%- endif -%}
  {%- if block_settings.heading_color != blank -%}
    --color: {{ block_settings.heading_color }};
    color: {{ block_settings.heading_color }};
  {%- endif -%}
{% endcapture %}

{% assign heading_style_value = heading_style | strip | strip_newlines %}

{% if has_items or show_placeholders or heading != blank %}
  <div
    class="
      product-information-details
      product-information-details--{{ block.id }}
      spacing-style
    "
    style="
      {% render 'spacing-style', settings: block_settings %}
      --product-information-details-gap: {{ block_settings.gap }}px;
      --product-information-details-align: {{ align_items }};
      --product-information-details-text-align: {{ text_align }};
      --product-information-details-item-padding-block-start: {{ block_settings.item_padding_top }}px;
      --product-information-details-item-padding-block-end: {{ block_settings.item_padding_bottom }}px;
      --product-information-details-item-padding-inline-start: {{ block_settings.item_padding_left }}px;
      --product-information-details-item-padding-inline-end: {{ block_settings.item_padding_right }}px;
      {% if block_settings.text_color != blank %}
        --product-information-details-text-color: {{ block_settings.text_color }};
      {% endif %}
      {% if block_settings.background_color != blank %}
        --product-information-details-item-background: {{ block_settings.background_color }};
      {% endif %}
      --border-radius: {{ block_settings.border_radius }}px;
      {% if block_settings.enable_border %}
        --border-width: {{ block_settings.border_width }}px;
        --border-style: solid;
        --border-color:
        {% if block_settings.border_color != blank %}
          rgb({{ block_settings.border_color.rgba }})
        {% else %}
          rgb(var(--color-border-rgb) / {{ block_settings.border_opacity | divided_by: 100.0 }})
        {% endif %}
        ;
      {% else %}
        --border-width: 0px;
        --border-style: none;
      {% endif %}
    "
    {{ block.shopify_attributes }}
  >
    {% if heading != blank %}
      <p
        class="{{ heading_classes }}"
        {% if heading_style_value != blank %}
          style="{{ heading_style_value }}"
        {% endif %}
      >
        {{ heading | escape }}
      </p>
    {% endif %}

    {% if has_items or show_placeholders %}
      <ul class="product-information-details__items">
        {% if has_items %}
          {% for item in detail_items %}
            {% assign item_text = item | strip %}
            {% if item_text != blank %}
              <li
                class="{{ item_classes }}"
                style="{% render 'typography-style', settings: block_settings, preset: text_preset, type: text_type %}{% if block_settings.weight != blank %} --font-weight: {{ block_settings.weight }};{% endif %}{% if block_settings.text_color != blank %} --color: {{ block_settings.text_color }}; color: {{ block_settings.text_color }};{% endif %}"
              >
                {{ item_text | escape }}
              </li>
            {% endif %}
          {% endfor %}
        {% else %}
          <li
            class="{{ item_classes }}"
            style="{% render 'typography-style', settings: block_settings, preset: text_preset, type: text_type %}{% if block_settings.weight != blank %} --font-weight: {{ block_settings.weight }};{% endif %}{% if block_settings.text_color != blank %} --color: {{ block_settings.text_color }}; color: {{ block_settings.text_color }};{% endif %}"
          >
            Non-GMO
          </li>
          <li
            class="{{ item_classes }}"
            style="{% render 'typography-style', settings: block_settings, preset: text_preset, type: text_type %}{% if block_settings.weight != blank %} --font-weight: {{ block_settings.weight }};{% endif %}{% if block_settings.text_color != blank %} --color: {{ block_settings.text_color }}; color: {{ block_settings.text_color }};{% endif %}"
          >
            Gluten-Free
          </li>
          <li
            class="{{ item_classes }}"
            style="{% render 'typography-style', settings: block_settings, preset: text_preset, type: text_type %}{% if block_settings.weight != blank %} --font-weight: {{ block_settings.weight }};{% endif %}{% if block_settings.text_color != blank %} --color: {{ block_settings.text_color }}; color: {{ block_settings.text_color }};{% endif %}"
          >
            Hand-Packed
          </li>
        {% endif %}
      </ul>
    {% endif %}
  </div>
{% endif %}

{% stylesheet %}
  .product-information-details {
    display: flex;
    flex-direction: column;
    align-items: var(--product-information-details-align, flex-start);
    gap: var(--product-information-details-gap, 8px);
    width: 100%;
  }

  .product-information-details .product-information-details__heading,
  .product-information-details .product-information-details__heading.h4,
  .product-information-details .product-information-details__heading.h5,
  .product-information-details .product-information-details__heading.h6,
  .product-information-details .product-information-details__heading.paragraph,
  .product-information-details .product-information-details__heading.paragraph:not(.button) {
    margin: 0;
    width: 100%;
    text-align: var(--product-information-details-text-align, start);
    color: var(--color, inherit);
    font-family: var(--product-information-details-heading-font, inherit);
  }

  .product-information-details .product-information-details__heading--weight,
  .product-information-details .product-information-details__heading--weight.h4,
  .product-information-details .product-information-details__heading--weight.h5,
  .product-information-details .product-information-details__heading--weight.h6,
  .product-information-details .product-information-details__heading--weight.paragraph,
  .product-information-details .product-information-details__heading--weight.paragraph:not(.button) {
    font-weight: var(--product-information-details-heading-weight);
  }

  .product-information-details__items {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: var(--product-information-details-align, flex-start);
    gap: var(--product-information-details-gap, 8px);
    list-style: none;
    margin: 0;
    padding: 0;
    width: 100%;
  }

  .product-information-details__item {
    box-sizing: border-box;
    width: fit-content;
    max-width: 100%;
    margin: 0;
    color: var(--product-information-details-text-color, inherit);
    background-color: var(--product-information-details-item-background, transparent);
    padding-block-start: var(--product-information-details-item-padding-block-start, 0);
    padding-block-end: var(--product-information-details-item-padding-block-end, 0);
    padding-inline-start: var(--product-information-details-item-padding-inline-start, 0);
    padding-inline-end: var(--product-information-details-item-padding-inline-end, 0);
  }
{% endstylesheet %}

