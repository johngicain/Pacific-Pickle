{% liquid
  assign block_settings = block.settings
  assign product = closest.product

  if request.visual_preview_mode and product == blank
    assign product = collections.all.products.first
  endif

  assign variant = product.selected_or_first_available_variant
  assign inventory_quantity = variant.inventory_quantity | default: 0 | plus: 0 | at_least: 0
  assign inventory_tracked = false

  if variant.inventory_management == 'shopify'
    assign inventory_tracked = true
  endif

  assign show_stocks = false
  if inventory_tracked
    assign show_stocks = true
  endif

  if request.visual_preview_mode or request.design_mode
    assign show_stocks = true
    if inventory_tracked == false
      assign inventory_quantity = 24
    endif
  endif

  assign type_preset = block_settings.type_preset | default: 'paragraph'
  assign stocks_classes = 'product-stocks product-stocks--' | append: block.id
  assign text_type = 'body'

  if type_preset == 'custom'
    assign stocks_classes = stocks_classes | append: ' custom-typography'
  elsif type_preset != blank
    assign stocks_classes = stocks_classes | append: ' ' | append: type_preset
  endif

  if block_settings.weight != blank
    assign stocks_classes = stocks_classes | append: ' custom-font-weight'
  endif

  if block_settings.font_size != blank
    assign stocks_classes = stocks_classes | append: ' custom-font-size'
    assign font_size_value = block_settings.font_size | split: 'rem' | first | times: 1.0
    if font_size_value >= 3
      assign text_type = 'display'
    elsif font_size_value >= 1.25
      assign text_type = 'heading'
    endif
  endif

  assign stocks_classes = stocks_classes | append: ' spacing-style border-style'
  if block_settings.background_color != blank or block_settings.text_color != blank
    assign stocks_classes = stocks_classes | append: ' color-custom-' | append: block.id
  endif

  assign max_width = 'fit-content'
  if block_settings.max_width == 'custom'
    assign stocks_classes = stocks_classes | append: ' product-stocks--custom-max-width'
    assign max_width = block_settings.custom_max_width | append: '%'
  endif
%}

{% if block_settings.background_color != blank or block_settings.text_color != blank %}
  {% render 'contrast-override',
    background_color: block_settings.background_color,
    text_color: block_settings.text_color,
    border_color: block_settings.border_color,
    section_id: block.id
  %}
{% endif %}

<product-stocks
  class="{{ stocks_classes }}"
  data-product-id="{{ product.id }}"
  data-block-id="{{ block.id }}"
  {% unless show_stocks %}
    hidden
  {% endunless %}
  style="
    {% render 'typography-style', settings: block_settings, preset: type_preset, type: text_type %}
    {% render 'spacing-style', settings: block_settings %}
    {% render 'border-override', settings: block_settings %}
    --product-stocks-icon-size: {{ block_settings.icon_size }}px;
    {% if block_settings.icon_color != blank %}
      --product-stocks-icon-color: {{ block_settings.icon_color }};
    {% endif %}
    {% if block_settings.font_size != blank %}
      --font-size: {{ block_settings.font_size }};
      --product-stocks-font-size: {{ block_settings.font_size }};
    {% endif %}
    {% if block_settings.weight != blank %}
      --font-weight: {{ block_settings.weight }};
    {% endif %}
    {% if block_settings.text_color != blank %}
      --color: {{ block_settings.text_color }};
    {% endif %}
    --product-stocks-max-width: {{ max_width }};
  "
  {{ block.shopify_attributes }}
>
  {% if block_settings.show_icon %}
    <span class="product-stocks__icon" aria-hidden="true">
      {{ 'icon-zap.svg' | inline_asset_content }}
    </span>
  {% endif %}
  <span
    class="product-stocks__value"
    role="status"
    aria-label="{{ 'accessibility.product_stocks' | t: count: inventory_quantity }}"
  >
    {{ 'content.product_stocks' | t: count: inventory_quantity }}
  </span>
</product-stocks>

{% stylesheet %}
  .product-stocks {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    width: fit-content;
    max-width: var(--product-stocks-max-width, 100%);
    color: var(--color, inherit);
    box-sizing: border-box;
    font-weight: var(--font-weight, 600);
  }

  .product-stocks--custom-max-width {
    width: 100%;
  }

  .product-stocks[hidden] {
    display: none;
  }

  .product-stocks__icon,
  .product-stocks__icon svg {
    display: block;
    flex-shrink: 0;
    width: var(--product-stocks-icon-size, 14px);
    height: var(--product-stocks-icon-size, 14px);
    color: var(--product-stocks-icon-color, #c4541a);
  }

  .product-stocks__value {
    margin: 0;
    white-space: nowrap;
    font-weight: var(--font-weight, 600);
  }

  .product-stocks--custom-max-width .product-stocks__value {
    white-space: normal;
    min-width: 0;
  }

  .product-stocks.custom-font-size,
  .product-stocks.custom-font-size .product-stocks__value {
    font-size: var(--product-stocks-font-size, var(--font-size));
  }

  .product-stocks.custom-font-weight,
  .product-stocks.custom-font-weight .product-stocks__value {
    font-weight: var(--font-weight, 600);
  }
{% endstylesheet %}

