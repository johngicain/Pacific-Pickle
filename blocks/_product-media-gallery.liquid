{% liquid
  assign block_settings = block.settings
  assign desktop_columns = block_settings.columns | default: 3
  assign mobile_columns = block_settings.mobile_columns | default: 1
%}

{% if block_settings.background_color != blank %}
  {% render 'contrast-override', background_color: block_settings.background_color, section_id: block.id %}
{% endif %}

{% capture nested_blocks %}
  <div
    class="
      product-media-block__multicolumn
      border-style
      {% if block_settings.background_color != blank %} color-custom-{{ block.id }}{% endif %}
      {% if block_settings.background_color != blank or block_settings.border != 'none' %} product-media-block__multicolumn--surface{% endif %}
    "
    style="
      {% render 'border-override', settings: block_settings %}
      --product-media-columns: {{ desktop_columns }};
      --product-media-columns-mobile: {{ mobile_columns }};
      --product-media-columns-gap: {{ block_settings.columns_gap | default: 8 }}px;
    "
  >
    {% content_for 'blocks' %}
  </div>
{% endcapture %}

<div
  class="product-media-block"
  {{ block.shopify_attributes }}
>
  {% render 'product-media-gallery-content',
    media_presentation: block.settings.media_presentation,
    block_settings: block.settings,
    block_id: block.id,
    block_shopify_attributes: '',
    block: block,
    section: section,
    nested_blocks: nested_blocks
  %}
</div>

{% stylesheet %}
  .product-media-block {
    width: 100%;
    min-width: 0;
  }

  .product-media-block__multicolumn {
    display: grid;
    grid-template-columns: repeat(var(--product-media-columns-mobile, 1), minmax(0, 1fr));
    gap: var(--product-media-columns-gap, 8px);
    width: 100%;
    min-width: 0;
    margin-block-start: var(--padding-md, 12px);
  }

  .product-media-block__multicolumn:not(:has(*)) {
    display: none;
  }

  .product-media-block__multicolumn--surface {
    padding: var(--padding-sm, 8px);
  }

  @media screen and (min-width: 750px) {
    .product-media-block__multicolumn {
      grid-template-columns: repeat(var(--product-media-columns, 3), minmax(0, 1fr));
    }
  }

  .product-media-block__multicolumn > .shopify-block:has(.group-block, .details-multicolumn) {
    grid-column: 1 / -1;
  }
{% endstylesheet %}

{% schema %}
{
