{% liquid
  assign filter_title = block.settings.title | strip
  assign filter_handle = filter_title | handleize
  assign matches = false

  if filter_handle != blank
    for article in blog.articles
      assign category_handle = article.metafields.custom.category.value | handleize
      if category_handle == filter_handle
        assign matches = true
        break
      endif
    endfor
  endif
%}

{% if matches or request.design_mode %}
  <button
    type="button"
    class="blog-filters__item{% if matches == false %} blog-filters__item--unmatched{% endif %}"
    data-category="{{ filter_handle }}"
    aria-pressed="false"
    on:click="/selectFilter"
    {{ block.shopify_attributes }}
  >
    {%- if filter_title != blank -%}
      {{- filter_title -}}
    {%- else -%}
      {{- 'blocks.filter' | t -}}
    {%- endif -%}
  </button>
{% endif %}

{% schema %}
{
  "name": "t:names.blog_filter",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "t:settings.title",
      "info": "t:info.blog_filter_title"
    }
  ]
}
{% endschema %}
