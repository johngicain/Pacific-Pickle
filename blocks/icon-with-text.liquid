{% liquid
  assign block_settings = block.settings
  assign heading = block_settings.heading
  assign text = block_settings.text
  assign icon_class = 'icon-with-text__media icon-with-text__media--' | append: block.id
  assign show_icon = false
  assign text_align = 'start'

  if block_settings.icon != 'none' or block_settings.image_upload != blank
    assign show_icon = true
  endif

  if block_settings.horizontal_alignment == 'center'
    assign text_align = 'center'
  elsif block_settings.horizontal_alignment == 'flex-end'
    assign text_align = 'end'
  endif

  assign wrapper_tag = 'div'
  if block_settings.link != blank
    assign wrapper_tag = 'a'
  endif
%}

{% if block_settings.background_color != blank %}
  {% render 'contrast-override',
    background_color: block_settings.background_color,
    text_color: block_settings.text_color,
    border_color: block_settings.border_color,
    section_id: block.id
  %}
{% endif %}

{% if block_settings.icon_color != blank or block_settings.text_color != blank %}
  {% style %}
    .icon-with-text--{{ block.id }} {
      {% if block_settings.icon_color != blank %}
        --icon-with-text-icon-color: {{ block_settings.icon_color }};
      {% endif %}
      {% if block_settings.text_color != blank %}
        --icon-with-text-text-color: {{ block_settings.text_color }};
        --color: {{ block_settings.text_color }};
      {% endif %}
    }
  {% endstyle %}
{% endif %}

<{{ wrapper_tag }}
  class="
    icon-with-text
    icon-with-text--{{ block.id }}
    icon-with-text--{{ block_settings.icon_position }}
    spacing-style
    border-style
    {% if block_settings.background_color != blank %} color-custom-{{ block.id }}{% endif %}
    {% if block_settings.link != blank %}icon-with-text--link{% endif %}
  "
  style="
    {% render 'spacing-style', settings: block_settings %}
    {% render 'border-override', settings: block_settings %}
    --icon-with-text-gap: {{ block_settings.gap }}px;
    --icon-with-text-align: {{ block_settings.vertical_alignment }};
    --icon-with-text-horizontal-align: {{ block_settings.horizontal_alignment }};
    --icon-with-text-text-align: {{ text_align }};
    {% if block_settings.font_size != blank %}
      --icon-with-text-font-size: {{ block_settings.font_size }};
    {% endif %}
  "
  {% if block_settings.link != blank %}
    href="{{ block_settings.link }}"
    {% if block_settings.open_in_new_tab %}
      target="_blank"
      rel="noopener noreferrer"
    {% endif %}
  {% endif %}
  {{ block.shopify_attributes }}
>
  {% if show_icon %}
    {% render 'icon-or-image',
      icon: block_settings.icon,
      image_upload: block_settings.image_upload,
      width: block_settings.width,
      class_name: icon_class
    %}
  {% endif %}

  {% if heading != blank or text != blank or request.design_mode %}
    <div class="icon-with-text__content">
      {% if heading != blank or request.design_mode %}
        <p class="icon-with-text__heading {{ block_settings.heading_preset }}">
          {{ heading }}
        </p>
      {% endif %}
      {% if text != blank %}
        <div class="icon-with-text__text rte{% if block_settings.font_size != blank %} icon-with-text__text--custom-size{% endif %}">
          {{ text }}
        </div>
      {% endif %}
    </div>
  {% endif %}
</{{ wrapper_tag }}>

{% stylesheet %}
  .icon-with-text {
    display: flex;
    gap: var(--icon-with-text-gap, 12px);
    align-items: var(--icon-with-text-align, center);
    color: var(--icon-with-text-text-color, inherit);
    max-width: 100%;
  }

  .icon-with-text--top {
    flex-direction: column;
    align-items: var(--icon-with-text-horizontal-align, flex-start);
    text-align: var(--icon-with-text-text-align, start);
  }

  .icon-with-text--right {
    flex-direction: row-reverse;
    justify-content: flex-end;
  }

  .icon-with-text--link {
    color: inherit;
    text-decoration: none;
  }

  .icon-with-text__media {
    flex-shrink: 0;
    display: block;
    height: auto;
    color: var(--icon-with-text-icon-color, currentColor);
  }

  .icon-with-text__content {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    min-width: 0;
  }

  .icon-with-text__heading {
    margin: 0;
  }

  .icon-with-text__text--custom-size,
  .icon-with-text__text--custom-size > * {
    font-size: var(--icon-with-text-font-size);
  }

  .icon-with-text__text > *:first-child {
    margin-block-start: 0;
  }

  .icon-with-text__text > *:last-child {
    margin-block-end: 0;
  }
{% endstylesheet %}

