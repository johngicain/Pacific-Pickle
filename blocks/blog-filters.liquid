{% doc %}
  Renders blog category filters. Nested filter titles are shown when they match an article category tag.
  @example
  {% content_for 'block', type: 'blog-filters', id: 'filters' %}
{% enddoc %}

<script
  src="{{ 'blog-filters.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{% liquid
  assign alignment = 'flex-start'
  if block.settings.alignment == 'center'
    assign alignment = 'center'
  elsif block.settings.alignment == 'right'
    assign alignment = 'flex-end'
  endif

  if block.settings.background_color != blank
    render 'contrast-override', background_color: block.settings.background_color, text_color: block.settings.color, section_id: block.id
  endif
%}

<blog-filters-component
  class="blog-filters{% if block.settings.background_color != blank %} color-custom-{{ block.id }}{% endif %}"
  style="
    --blog-filters-alignment: {{ alignment }};
    --blog-filters-padding-top: {{ block.settings['padding-top'] | default: 0 }}px;
    --blog-filters-padding-bottom: {{ block.settings['padding-bottom'] | default: 0 }}px;
    --blog-filters-padding-left: {{ block.settings['padding-left'] | default: 0 }}px;
    --blog-filters-padding-right: {{ block.settings['padding-right'] | default: 0 }}px;
    --blog-filters-active-border-width: {{ block.settings.active_border_bottom | default: 0 }}px;
    {% if block.settings.font_size != blank %}
      --blog-filters-font-size: {{ block.settings.font_size }};
    {% endif %}
    {% if block.settings.color != blank %}
      --blog-filters-color: {{ block.settings.color }};
    {% endif %}
    {% if block.settings.background_color != blank %}
      --blog-filters-background: {{ block.settings.background_color }};
    {% endif %}
    {% if block.settings.active_border_bottom_color != blank %}
      --blog-filters-active-border-color: {{ block.settings.active_border_bottom_color }};
    {% endif %}
  "
  {{ block.shopify_attributes }}
>
  <nav
    class="blog-filters__nav"
    aria-label="{{ 'accessibility.filters' | t }}"
  >
    <button
      type="button"
      class="blog-filters__item is-active"
      data-category=""
      aria-pressed="true"
      on:click="/selectFilter"
    >
      {%- if block.settings.all_label != blank -%}
        {{ block.settings.all_label | escape }}
      {%- else -%}
        {{ 'actions.view_all' | t }}
      {%- endif -%}
    </button>
    {% content_for 'blocks' %}
  </nav>
</blog-filters-component>

{% stylesheet %}
  .blog-filters {
    display: block;
    width: 100%;
    background-color: var(--blog-filters-background, transparent);
    color: var(--blog-filters-color, var(--color-foreground));
    padding-top: var(--blog-filters-padding-top, 0px);
    padding-bottom: var(--blog-filters-padding-bottom, 0px);
    padding-left: var(--blog-filters-padding-left, 0px);
    padding-right: var(--blog-filters-padding-right, 0px);
  }

  .blog-filters__nav {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    justify-content: var(--blog-filters-alignment, center);
    gap: 0.5rem 2rem;
    width: 100%;
  }

  .blog-filters__item {
    appearance: none;
    background: transparent;
    border: 0;
    border-bottom: var(--blog-filters-active-border-width, 0px) solid transparent;
    color: inherit;
    cursor: pointer;
    font-family: var(--font-body--family);
    font-size: var(--blog-filters-font-size, 0.875rem);
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1.2;
    margin: 0;
    padding: 1rem 0.15rem;
    text-align: center;
    text-decoration: none;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .blog-filters__item.is-active,
  .blog-filters__item[aria-pressed='true'] {
    color: var(--blog-filters-active-border-color, inherit);
    border-bottom-color: var(--blog-filters-active-border-color, currentColor);
  }

  .blog-filters__item--empty {
    display: none;
  }

  .blog-post-item.is-filter-hidden {
    display: none !important;
  }

  @media screen and (max-width: 749px) {
    .blog-filters__nav {
      flex-wrap: nowrap;
      justify-content: flex-start;
      overflow-x: auto;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.blog_filters",
  "tag": null,
  "blocks": [
    {
      "type": "_blog-filter"
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "all_label",
      "label": "t:settings.all_label",
      "default": "View All"
    },
    {
      "type": "text_alignment",
      "id": "alignment",
      "label": "t:settings.alignment",
      "default": "center"
    },
    {
      "type": "select",
      "id": "font_size",
      "label": "t:settings.font_size",
      "options": [
        {
          "value": "0.75rem",
          "label": "12px"
        },
        {
          "value": "0.875rem",
          "label": "14px"
        },
        {
          "value": "1rem",
          "label": "16px"
        },
        {
          "value": "1.125rem",
          "label": "18px"
        },
        {
          "value": "1.25rem",
          "label": "20px"
        },
        {
          "value": "1.5rem",
          "label": "24px"
        }
      ],
      "default": "0.875rem"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "color",
      "id": "color",
      "label": "t:settings.color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "range",
      "id": "active_border_bottom",
      "label": "t:settings.active_border_bottom",
      "min": 0,
      "max": 10,
      "step": 1,
      "unit": "px",
      "default": 3
    },
    {
      "type": "color",
      "id": "active_border_bottom_color",
      "label": "t:settings.active_border_bottom_color",
      "placeholder": "t:settings.default",
      "visible_if": "{{ block.settings.active_border_bottom > 0 }}"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-top",
      "label": "t:settings.top_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-bottom",
      "label": "t:settings.bottom_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-left",
      "label": "t:settings.left_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding-right",
      "label": "t:settings.right_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24
    }
  ],
  "presets": [
    {
      "name": "t:names.blog_filters",
      "category": "t:categories.blog_post",
      "settings": {
        "all_label": "View All",
        "alignment": "center",
        "font_size": "0.875rem",
        "active_border_bottom": 3
      },
      "blocks": {
        "filter-1": {
          "type": "_blog-filter",
          "settings": {
            "title": "Cocktails & Drinks"
          }
        },
        "filter-2": {
          "type": "_blog-filter",
          "settings": {
            "title": "Mains & Sides"
          }
        },
        "filter-3": {
          "type": "_blog-filter",
          "settings": {
            "title": "Snacks & Apps"
          }
        }
      },
      "block_order": ["filter-1", "filter-2", "filter-3"]
    }
  ]
}
{% endschema %}
