{% liquid
  assign block_settings = block.settings
  assign product = closest.product

  if request.visual_preview_mode and product == blank
    assign product = collections.all.products.first
  endif

  assign cart_quantity = 0
  if product != blank
    assign cart_line_items = cart | line_items_for: product
    assign cart_quantity = cart_line_items | sum: 'quantity' | default: 0 | plus: 0 | at_least: 0
  endif

  assign show_cart_visitors = false
  if cart_quantity > 0
    assign show_cart_visitors = true
  endif

  if request.visual_preview_mode or request.design_mode
    assign show_cart_visitors = true
    if cart_quantity == 0
      assign cart_quantity = 3
    endif
  endif

  assign type_preset = block_settings.type_preset | default: 'paragraph'
  assign visitors_classes = 'product-cart-visitors product-cart-visitors--' | append: block.id
  assign text_type = 'body'
  assign adjacent_text = block_settings.text | strip

  if type_preset == 'custom'
    assign visitors_classes = visitors_classes | append: ' custom-typography'
  elsif type_preset != blank
    assign visitors_classes = visitors_classes | append: ' ' | append: type_preset
  endif

  if block_settings.weight != blank
    assign visitors_classes = visitors_classes | append: ' custom-font-weight'
  endif

  if block_settings.font_size != blank
    assign visitors_classes = visitors_classes | append: ' custom-font-size'
    assign font_size_value = block_settings.font_size | split: 'rem' | first | times: 1.0
    if font_size_value >= 3
      assign text_type = 'display'
    elsif font_size_value >= 1.25
      assign text_type = 'heading'
    endif
  endif

  assign visitors_classes = visitors_classes | append: ' spacing-style border-style'
  if block_settings.background_color != blank or block_settings.text_color != blank
    assign visitors_classes = visitors_classes | append: ' color-custom-' | append: block.id
  endif

  assign max_width = 'fit-content'
  if block_settings.max_width == 'custom'
    assign visitors_classes = visitors_classes | append: ' product-cart-visitors--custom-max-width'
    assign max_width = block_settings.custom_max_width | append: '%'
  endif
%}

{% if block_settings.background_color != blank or block_settings.text_color != blank %}
  {% render 'contrast-override',
    background_color: block_settings.background_color,
    text_color: block_settings.text_color,
    border_color: block_settings.border_color,
    section_id: block.id
  %}
{% endif %}

<product-cart-visitors
  class="{{ visitors_classes }}"
  data-product-id="{{ product.id }}"
  data-block-id="{{ block.id }}"
  data-text="{{ adjacent_text | escape }}"
  {% if request.visual_preview_mode or request.design_mode %}
    data-preview
  {% endif %}
  {% unless show_cart_visitors %}
    hidden
  {% endunless %}
  style="
    {% render 'typography-style', settings: block_settings, preset: type_preset, type: text_type %}
    {% render 'spacing-style', settings: block_settings %}
    {% render 'border-override', settings: block_settings %}
    --product-cart-visitors-icon-size: {{ block_settings.icon_size }}px;
    --product-cart-visitors-gap: {{ block_settings.gap }}px;
    {% if block_settings.icon_color != blank %}
      --product-cart-visitors-icon-color: {{ block_settings.icon_color }};
    {% endif %}
    {% if block_settings.font_size != blank %}
      --font-size: {{ block_settings.font_size }};
      --product-cart-visitors-font-size: {{ block_settings.font_size }};
    {% endif %}
    {% if block_settings.weight != blank %}
      --font-weight: {{ block_settings.weight }};
    {% endif %}
    {% if block_settings.text_color != blank %}
      --color: {{ block_settings.text_color }};
    {% endif %}
    --product-cart-visitors-max-width: {{ max_width }};
  "
  role="status"
  aria-label="{{ 'accessibility.product_cart_visitors' | t: count: cart_quantity, text: adjacent_text }}"
  {{ block.shopify_attributes }}
>
  {% if block_settings.show_icon %}
    <span class="product-cart-visitors__icon" aria-hidden="true">🛒</span>
  {% endif %}
  <span class="product-cart-visitors__count" ref="count">{{ cart_quantity }}</span>
  {% if adjacent_text != blank %}
    <span class="product-cart-visitors__text">{{ adjacent_text | escape }}</span>
  {% endif %}
</product-cart-visitors>

{% stylesheet %}
  .product-cart-visitors {
    display: inline-flex;
    align-items: center;
    gap: var(--product-cart-visitors-gap, 4px);
    width: fit-content;
    max-width: var(--product-cart-visitors-max-width, 100%);
    color: var(--color, inherit);
    box-sizing: border-box;
    font-weight: var(--font-weight, 600);
  }

  .product-cart-visitors--custom-max-width {
    width: 100%;
  }

  .product-cart-visitors[hidden] {
    display: none;
  }

  .product-cart-visitors__icon {
    flex-shrink: 0;
    font-size: var(--product-cart-visitors-icon-size, 14px);
    line-height: 1;
    color: var(--product-cart-visitors-icon-color, #c4541a);
  }

  .product-cart-visitors__count,
  .product-cart-visitors__text {
    margin: 0;
    font-weight: var(--font-weight, 600);
  }

  .product-cart-visitors__count {
    white-space: nowrap;
  }

  .product-cart-visitors--custom-max-width .product-cart-visitors__text {
    min-width: 0;
  }

  .product-cart-visitors.custom-font-size,
  .product-cart-visitors.custom-font-size .product-cart-visitors__count,
  .product-cart-visitors.custom-font-size .product-cart-visitors__text {
    font-size: var(--product-cart-visitors-font-size, var(--font-size));
  }

  .product-cart-visitors.custom-font-weight,
  .product-cart-visitors.custom-font-weight .product-cart-visitors__count,
  .product-cart-visitors.custom-font-weight .product-cart-visitors__text {
    font-weight: var(--font-weight, 600);
  }
{% endstylesheet %}

