<th
  scope="row"
  style="
    --compare-cell-align: {{ block.settings.feature_alignment }};
    {% if block.settings.feature_background != blank -%}
      --compare-cell-bg: {{ block.settings.feature_background }};
    {% endif -%}
    {% render 'compare-row-cell-style', preset: block.settings.feature_type_preset, font: block.settings.feature_font, font_size: block.settings.feature_font_size, weight: block.settings.feature_weight, letter_spacing: block.settings.feature_letter_spacing, text_case: block.settings.feature_case %}
  "
>
  {{ block.settings.feature }}
</th>
<td
  class="ppw-compare__ours"
  style="
    --compare-cell-align: {{ block.settings.ours_alignment }};
    {% if block.settings.ours_background != blank -%}
      --compare-cell-bg: {{ block.settings.ours_background }};
    {% endif -%}
    {% render 'compare-row-cell-style', preset: block.settings.ours_type_preset, font: block.settings.ours_font, font_size: block.settings.ours_font_size, weight: block.settings.ours_weight, letter_spacing: block.settings.ours_letter_spacing, text_case: block.settings.ours_case %}
  "
>
  {{ block.settings.ours }}
</td>
<td
  style="
    --compare-cell-align: {{ block.settings.theirs_alignment }};
    {% if block.settings.theirs_background != blank -%}
      --compare-cell-bg: {{ block.settings.theirs_background }};
    {% endif -%}
    {% render 'compare-row-cell-style', preset: block.settings.theirs_type_preset, font: block.settings.theirs_font, font_size: block.settings.theirs_font_size, weight: block.settings.theirs_weight, letter_spacing: block.settings.theirs_letter_spacing, text_case: block.settings.theirs_case %}
  "
>
  {{ block.settings.theirs }}
</td>

