{% liquid
  assign share_label = block.settings.share_label
  assign print_label = block.settings.print_label
  if share_label == blank
    assign share_label = 'blogs.article.share' | t
  endif
  if print_label == blank
    assign print_label = 'blogs.article.print' | t
  endif
  assign share_url = canonical_url | default: article.url
  assign share_title = article.title | escape
  assign share_style_class = block.settings.share_style_class | default: 'button-unstyled'
  assign print_style_class = block.settings.print_style_class | default: 'button-unstyled'
  assign share_style_id = block.id | append: '-share'
  assign print_style_id = block.id | append: '-print'
  assign share_button_class = 'blog-post-share__button ' | append: share_style_class | append: ' ' | append: share_style_class | append: '--' | append: share_style_id
  if block.settings.share_box_shadow and share_style_class != 'button-unstyled'
    assign share_button_class = share_button_class | append: ' button--box-shadow'
  endif
  assign print_button_class = 'blog-post-share__button ' | append: print_style_class | append: ' ' | append: print_style_class | append: '--' | append: print_style_id
  if block.settings.print_box_shadow and print_style_class != 'button-unstyled'
    assign print_button_class = print_button_class | append: ' button--box-shadow'
  endif

  assign share_icon = blank
  if block.settings.share_show_icon
    assign share_icon = block.settings.share_icon
    assign share_button_class = share_button_class | append: ' blog-post-share__button--with-icon'
  endif
  if block.settings.share_hover_border != blank
    assign share_button_class = share_button_class | append: ' blog-post-share__button--hover-border'
  endif
  if block.settings.print_hover_border != blank
    assign print_button_class = print_button_class | append: ' blog-post-share__button--hover-border'
  endif

  assign print_icon = blank
  if block.settings.print_show_icon
    assign print_icon = block.settings.print_icon
    assign print_button_class = print_button_class | append: ' blog-post-share__button--with-icon'
  endif

  if block.settings.share_type_preset != blank
    assign share_button_class = share_button_class | append: ' blog-post-share__button--preset ' | append: block.settings.share_type_preset
  endif
  if block.settings.print_type_preset != blank
    assign print_button_class = print_button_class | append: ' blog-post-share__button--preset ' | append: block.settings.print_type_preset
  endif

  assign close_label = 'accessibility.close_dialog' | t
  assign copy_label = 'blogs.article.copy' | t
  assign copied_label = 'blogs.article.copied' | t
  assign category_label = 'blogs.article.category' | t
  assign duration_label = 'blogs.article.duration' | t
  assign servings_label = 'blogs.article.servings' | t
  assign prep_time_label = 'blogs.article.prep_time' | t
  assign cook_time_label = 'blogs.article.cook_time' | t
  assign total_time_label = 'blogs.article.total_time' | t
  assign difficulty_label = 'blogs.article.difficulty' | t
  assign ingredients_label = 'blogs.article.ingredients' | t
  assign instructions_label = 'blogs.article.instructions' | t
  assign pro_tips_label = 'blogs.article.pro_tips' | t
  assign tags_label = 'blogs.article.tags' | t
  assign author_label = 'blogs.article.author' | t
  assign published_label = 'blogs.article.published' | t
  assign sheet_title_id = block.id | append: '-share-title'

  assign category_value = article.metafields.custom.category.value | strip
  if category_value == blank
    assign category_value = article.metafields.custom.category | metafield_text | strip
  endif

  assign duration_hour = article.metafields.custom.duration_hour | metafield_text | strip
  assign duration_min = article.metafields.custom.duration_min | metafield_text | strip
  assign duration_value = duration_hour | append: ' ' | append: duration_min | strip

  assign servings_value = article.metafields.custom.serving_count.value
  if servings_value == blank
    assign servings_value = article.metafields.custom.serving_count | metafield_text | strip
  endif

  assign prep_time_value = article.metafields.custom.prep_time | metafield_text | strip
  assign cook_time_value = article.metafields.custom.cook_time | metafield_text | strip
  assign total_time_value = article.metafields.custom.total_time | metafield_text | strip

  assign difficulty_value = article.metafields.custom.difficulty.value.label.value | strip
  if difficulty_value == blank
    assign difficulty_value = article.metafields.custom.difficulty | metafield_text | strip
  endif

  assign excerpt_value = article.excerpt | strip_html | strip
  assign author_value = article.author | strip
  assign published_value = article.published_at | date: '%B %d, %Y'
  assign image_alt = article.image.alt | default: article.title
%}

{% render 'button-custom-styles',
  block_settings: block.settings,
  block_id: share_style_id,
  prefix: 'share'
%}
{% render 'button-custom-styles',
  block_settings: block.settings,
  block_id: print_style_id,
  prefix: 'print'
%}

<div
  class="blog-post-share spacing-style"
  style="{% render 'spacing-style', settings: block.settings %}"
  {{ block.shopify_attributes }}
>
  <button
    type="button"
    class="{{ share_button_class }}"
    style="{% render 'blog-post-share-button-style', settings: block.settings, prefix: 'share' %}"
    data-share-url="{{ share_url }}"
    data-share-title="{{ share_title }}"
    data-copied-label="{{ 'blogs.article.link_copied' | t | escape }}"
  >
    {%- if share_icon != blank -%}
      <span class="blog-post-share__icon" aria-hidden="true">
        {{- share_icon | inline_asset_content -}}
      </span>
    {%- endif -%}
    <span class="blog-post-share__label">{{ share_label }}</span>
  </button>
  <button
    type="button"
    class="{{ print_button_class }}"
    style="{% render 'blog-post-share-button-style', settings: block.settings, prefix: 'print' %}"
    data-print
  >
    {%- if print_icon != blank -%}
      <span class="blog-post-share__icon" aria-hidden="true">
        {{- print_icon | inline_asset_content -}}
      </span>
    {%- endif -%}
    <span class="blog-post-share__label">{{ print_label }}</span>
  </button>

  {% capture ingredient_groups %}
    {% render 'article-share-group', group: article.metafields.custom.ingredient_list_1.value, fallback_label: ingredients_label %}
    {% render 'article-share-group', group: article.metafields.custom.ingredient_list_2.value, fallback_label: ingredients_label %}
    {% render 'article-share-group', group: article.metafields.custom.ingredient_list_3.value, fallback_label: ingredients_label %}
    {% render 'article-share-group', group: article.metafields.custom.ingredient_list_4.value, fallback_label: ingredients_label %}
    {% render 'article-share-group', group: article.metafields.custom.ingredient_list_5.value, fallback_label: ingredients_label %}
  {% endcapture %}
  {% assign ingredient_groups = ingredient_groups | strip %}

  {% capture fallback_ingredients %}
    {% render 'article-share-list', source: article.metafields.custom.ingredients %}
  {% endcapture %}
  {% assign fallback_ingredients = fallback_ingredients | strip %}

  {% capture instructions_list %}
    {% render 'article-share-list', source: article.metafields.custom.instructions, tag: 'ol' %}
  {% endcapture %}
  {% assign instructions_list = instructions_list | strip %}

  {% capture pro_tips_list %}
    {% render 'article-share-list', source: article.metafields.custom.pro_tips %}
  {% endcapture %}
  {% assign pro_tips_list = pro_tips_list | strip %}

  <dialog
    class="blog-post-share__sheet"
    aria-labelledby="{{ sheet_title_id }}"
  >
    <div class="blog-post-share__sheet-bar">
      <button
        type="button"
        class="blog-post-share__sheet-close"
        data-share-close
        aria-label="{{ close_label | escape }}"
      >
        {{- 'icon-close.svg' | inline_asset_content -}}
      </button>
    </div>
    <article class="blog-post-share__document">
      {% if shop.name != blank %}
        <p class="blog-post-share__shop">{{ shop.name | escape }}</p>
      {% endif %}
      {% if category_value != blank %}
        <p class="blog-post-share__kicker">
          <span class="blog-post-share__field-label">{{ category_label | escape }}</span>
          <span>{{ category_value | escape }}</span>
        </p>
      {% endif %}
      <h2
        id="{{ sheet_title_id }}"
        class="blog-post-share__title"
      >
        {{ article.title | escape }}
      </h2>
      {% if article.image %}
        {{ article.image | image_url: width: 1200 | image_tag: class: 'blog-post-share__image', alt: image_alt, loading: 'lazy' }}
      {% endif %}
      {% if excerpt_value != blank %}
        <p class="blog-post-share__excerpt">{{ excerpt_value | escape }}</p>
      {% endif %}
      {% if duration_value != blank or servings_value != blank or prep_time_value != blank or cook_time_value != blank or total_time_value != blank or difficulty_value != blank %}
        <dl class="blog-post-share__meta">
          {% if duration_value != blank %}
            <div class="blog-post-share__meta-item">
              <dt>{{ duration_label | escape }}</dt>
              <dd>{{ duration_value | escape }}</dd>
            </div>
          {% endif %}
          {% if servings_value != blank %}
            <div class="blog-post-share__meta-item">
              <dt>{{ servings_label | escape }}</dt>
              <dd>{{ servings_value | escape }}</dd>
            </div>
          {% endif %}
          {% if prep_time_value != blank %}
            <div class="blog-post-share__meta-item">
              <dt>{{ prep_time_label | escape }}</dt>
              <dd>{{ prep_time_value | escape }}</dd>
            </div>
          {% endif %}
          {% if cook_time_value != blank %}
            <div class="blog-post-share__meta-item">
              <dt>{{ cook_time_label | escape }}</dt>
              <dd>{{ cook_time_value | escape }}</dd>
            </div>
          {% endif %}
          {% if total_time_value != blank %}
            <div class="blog-post-share__meta-item">
              <dt>{{ total_time_label | escape }}</dt>
              <dd>{{ total_time_value | escape }}</dd>
            </div>
          {% endif %}
          {% if difficulty_value != blank %}
            <div class="blog-post-share__meta-item">
              <dt>{{ difficulty_label | escape }}</dt>
              <dd>{{ difficulty_value | escape }}</dd>
            </div>
          {% endif %}
        </dl>
      {% endif %}
      {% if ingredient_groups != blank or fallback_ingredients != blank %}
        <section class="blog-post-share__section">
          <h3 class="blog-post-share__heading">{{ ingredients_label | escape }}</h3>
          {% if ingredient_groups != blank %}
            {{ ingredient_groups }}
          {% else %}
            {{ fallback_ingredients }}
          {% endif %}
        </section>
      {% endif %}
      {% if instructions_list != blank %}
        <section class="blog-post-share__section">
          <h3 class="blog-post-share__heading">{{ instructions_label | escape }}</h3>
          {{ instructions_list }}
        </section>
      {% endif %}
      {% if pro_tips_list != blank %}
        <section class="blog-post-share__section">
          <h3 class="blog-post-share__heading">{{ pro_tips_label | escape }}</h3>
          {{ pro_tips_list }}
        </section>
      {% endif %}
      {% if article.tags.size > 0 %}
        <section class="blog-post-share__section">
          <h3 class="blog-post-share__heading">{{ tags_label | escape }}</h3>
          <p class="blog-post-share__tags">{{ article.tags | join: ', ' | escape }}</p>
        </section>
      {% endif %}
      <dl class="blog-post-share__footer-meta">
        {% if author_value != blank %}
          <div class="blog-post-share__meta-item">
            <dt>{{ author_label | escape }}</dt>
            <dd>{{ author_value | escape }}</dd>
          </div>
        {% endif %}
        {% if published_value != blank %}
          <div class="blog-post-share__meta-item">
            <dt>{{ published_label | escape }}</dt>
            <dd>{{ published_value | escape }}</dd>
          </div>
        {% endif %}
        <div class="blog-post-share__meta-item">
          <dt>{{ share_label | escape }}</dt>
          <dd>
            <a href="{{ share_url }}">{{ share_url }}</a>
          </dd>
        </div>
      </dl>
    </article>
    <style class="blog-post-share__print-css">
      .blog-post-share__document {
        max-width: 46rem;
        margin: 0 auto;
        padding: 1.5rem;
        font-family: var(--font-body--family, Georgia, serif);
        color: #1c1c1a;
      }
      .blog-post-share__shop,
      .blog-post-share__kicker,
      .blog-post-share__heading,
      .blog-post-share__group-label,
      .blog-post-share__meta dt,
      .blog-post-share__footer-meta dt {
        margin: 0;
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.16em;
        line-height: 1.4;
        text-transform: uppercase;
      }
      .blog-post-share__shop { margin-bottom: 0.75rem; color: #e8821a; }
      .blog-post-share__kicker {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem 0.75rem;
        margin-bottom: 0.5rem;
        color: #e8821a;
      }
      .blog-post-share__field-label { color: #999; }
      .blog-post-share__title {
        margin: 0 0 1rem;
        font-family: var(--font-heading--family, Georgia, serif);
        font-size: 2rem;
        font-weight: 500;
        line-height: 1.15;
      }
      .blog-post-share__image { display: block; width: 100%; height: auto; margin: 0 0 1.25rem; }
      .blog-post-share__excerpt { margin: 0 0 1.5rem; font-size: 1.0625rem; line-height: 1.6; }
      .blog-post-share__meta,
      .blog-post-share__footer-meta {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(7.5rem, 1fr));
        gap: 1rem 1.25rem;
        margin: 0 0 1.75rem;
      }
      .blog-post-share__footer-meta {
        margin: 1.75rem 0 0;
        padding-top: 1.25rem;
        border-top: 1px solid #eaeaea;
      }
      .blog-post-share__meta dt,
      .blog-post-share__footer-meta dt { color: #999; }
      .blog-post-share__meta dd,
      .blog-post-share__footer-meta dd {
        margin: 0.25rem 0 0;
        font-family: var(--font-accent--family, var(--font-heading--family, Georgia, serif));
        font-size: 1.125rem;
        line-height: 1.3;
      }
      .blog-post-share__section { margin: 0 0 1.5rem; }
      .blog-post-share__heading {
        margin-bottom: 0.75rem;
        padding-bottom: 0.375rem;
        border-bottom: 2px solid currentcolor;
        font-family: var(--font-heading--family, Georgia, serif);
        font-size: 0.875rem;
        font-weight: 900;
        letter-spacing: 0.2em;
      }
      .blog-post-share__group { margin: 0 0 1rem; }
      .blog-post-share__group-label { margin-bottom: 0.5rem; color: #e8821a; }
      .blog-post-share__list { margin: 0; padding: 0; list-style: none; }
      .blog-post-share__list li {
        margin: 0 0 0.4rem;
        padding-left: 1.15rem;
        font-size: 0.9375rem;
        line-height: 1.45;
      }
      ol.blog-post-share__list { counter-reset: share-step; }
      ol.blog-post-share__list li { padding-left: 1.75rem; }
      .blog-post-share__list li::before {
        content: '•';
        display: inline-block;
        width: 1.15rem;
        margin-left: -1.15rem;
        color: #e8821a;
        font-weight: 700;
      }
      ol.blog-post-share__list li::before {
        counter-increment: share-step;
        content: counter(share-step) '.';
        width: 1.75rem;
        margin-left: -1.75rem;
      }
      .blog-post-share__tags { margin: 0; font-size: 0.9375rem; line-height: 1.5; }
    </style>
    <div class="blog-post-share__sheet-actions">
      <button
        type="button"
        class="button"
        data-share-copy
        data-copied-label="{{ copied_label | escape }}"
      >
        {{ copy_label }}
      </button>
      <button
        type="button"
        class="button-secondary"
        data-share-native
        hidden
      >
        {{ share_label }}
      </button>
      <button
        type="button"
        class="button-secondary"
        data-share-print-sheet
      >
        {{ print_label }}
      </button>
    </div>
  </dialog>
</div>

{% stylesheet %}
  @media screen and (min-width: 750px) {
    .group-block:has(.blog-post-share) {
      position: sticky;
      top: 5rem;
      align-self: flex-start;
    }
  }

  .blog-post-share {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    width: 100%;
  }

  .blog-post-share__button {
    flex: var(--blog-post-share-flex-mobile, var(--blog-post-share-flex, 0 0 auto));
    min-width: 0;
    max-width: var(
      --blog-post-share-max-width-mobile,
      var(--blog-post-share-max-width, none)
    );
  }

  @media screen and (min-width: 750px) {
    .blog-post-share__button {
      flex: var(--blog-post-share-flex, 0 0 auto);
      max-width: var(--blog-post-share-max-width, none);
    }
  }

  .blog-post-share__button.button-unstyled {
    padding: 0;
    border: 0;
    border-bottom: 2px solid currentColor;
    background: transparent;
    cursor: pointer;
  }

  .blog-post-share__button.button-unstyled:not(.blog-post-share__button--preset) {
    font-family: var(--font-body--family);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .blog-post-share .blog-post-share__button--with-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.375rem;
  }

  .blog-post-share__icon {
    display: inline-flex;
    flex-shrink: 0;
    width: 1em;
    height: 1em;
    pointer-events: none;
  }

  .blog-post-share__icon > svg {
    width: 100%;
    height: 100%;
  }

  .blog-post-share__button:hover {
    background-color: var(
      --blog-post-share-hover-background,
      var(--button-background-color)
    );
    color: var(--blog-post-share-hover-text, var(--button-color));
  }

  .blog-post-share__button--hover-border:hover {
    --button-border-color: var(--blog-post-share-hover-border);
  }

  .blog-post-share__button.button-unstyled:hover {
    background-color: var(--blog-post-share-hover-background, transparent);
    color: var(--blog-post-share-hover-text, #e8821a);
    border-bottom-color: var(
      --blog-post-share-hover-border,
      var(--blog-post-share-hover-text, #e8821a)
    );
  }

  .blog-post-share__sheet {
    width: min(46rem, calc(100vw - 1.5rem));
    max-height: calc(100vh - 1.5rem);
    margin: auto;
    padding: 0;
    overflow: hidden;
    border: 0;
    background: #fff;
    color: #1c1c1a;
    box-shadow: 0 1.5rem 3rem rgb(0 0 0 / 0.18);
  }

  .blog-post-share__sheet::backdrop {
    background: rgb(28 28 26 / 0.55);
  }

  .blog-post-share__sheet-bar {
    position: sticky;
    top: 0;
    z-index: 1;
    display: flex;
    justify-content: flex-end;
    padding: 0.75rem 0.75rem 0;
    background: #fff;
  }

  .blog-post-share__sheet-close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    border: 0;
    background: transparent;
    color: currentcolor;
    cursor: pointer;
  }

  .blog-post-share__sheet-close svg {
    width: 1rem;
    height: 1rem;
  }

  .blog-post-share__document {
    max-height: calc(100vh - 9rem);
    padding: 0 1.75rem 1.5rem;
    overflow: auto;
  }

  .blog-post-share__shop,
  .blog-post-share__kicker,
  .blog-post-share__heading,
  .blog-post-share__group-label,
  .blog-post-share__meta dt,
  .blog-post-share__footer-meta dt {
    margin: 0;
    font-family: var(--font-body--family);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .blog-post-share__shop {
    margin-bottom: 0.75rem;
    color: #e8821a;
  }

  .blog-post-share__kicker {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 0.75rem;
    margin-bottom: 0.5rem;
    color: #e8821a;
  }

  .blog-post-share__field-label {
    color: #999;
  }

  .blog-post-share__title {
    margin: 0 0 1rem;
    font-family: var(--font-heading--family);
    font-size: 2rem;
    font-weight: 500;
    line-height: 1.15;
  }

  .blog-post-share__image {
    display: block;
    width: 100%;
    height: auto;
    margin: 0 0 1.25rem;
  }

  .blog-post-share__excerpt {
    margin: 0 0 1.5rem;
    font-size: 1.0625rem;
    line-height: 1.6;
  }

  .blog-post-share__meta,
  .blog-post-share__footer-meta {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(7.5rem, 1fr));
    gap: 1rem 1.25rem;
    margin: 0 0 1.75rem;
  }

  .blog-post-share__footer-meta {
    margin: 1.75rem 0 0;
    padding-top: 1.25rem;
    border-top: 1px solid #eaeaea;
  }

  .blog-post-share__meta-item {
    min-width: 0;
  }

  .blog-post-share__meta dt,
  .blog-post-share__footer-meta dt {
    color: #999;
  }

  .blog-post-share__meta dd,
  .blog-post-share__footer-meta dd {
    margin: 0.25rem 0 0;
    font-family: var(--font-accent--family, var(--font-heading--family));
    font-size: 1.125rem;
    line-height: 1.3;
    overflow-wrap: anywhere;
  }

  .blog-post-share__section {
    margin: 0 0 1.5rem;
  }

  .blog-post-share__heading {
    margin-bottom: 0.75rem;
    padding-bottom: 0.375rem;
    border-bottom: 2px solid currentcolor;
    font-family: var(--font-heading--family);
    font-size: 0.875rem;
    font-weight: 900;
    letter-spacing: 0.2em;
  }

  .blog-post-share__group {
    margin: 0 0 1rem;
  }

  .blog-post-share__group-label {
    margin-bottom: 0.5rem;
    color: #e8821a;
  }

  .blog-post-share__list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .blog-post-share__list li {
    margin: 0 0 0.4rem;
    padding-left: 1.15rem;
    font-size: 0.9375rem;
    line-height: 1.45;
  }

  ol.blog-post-share__list {
    counter-reset: share-step;
  }

  ol.blog-post-share__list li {
    padding-left: 1.75rem;
  }

  .blog-post-share__list li::before {
    content: '•';
    display: inline-block;
    width: 1.15rem;
    margin-left: -1.15rem;
    color: #e8821a;
    font-weight: 700;
  }

  ol.blog-post-share__list li::before {
    counter-increment: share-step;
    content: counter(share-step) '.';
    width: 1.75rem;
    margin-left: -1.75rem;
  }

  .blog-post-share__tags {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  .blog-post-share__sheet-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    padding: 1rem 1.75rem 1.25rem;
    border-top: 1px solid #eaeaea;
    background: #fff;
  }

  @media print {
    body * {
      visibility: hidden !important;
    }

    .blog-post-share__sheet,
    .blog-post-share__sheet * {
      visibility: visible !important;
    }

    .blog-post-share__sheet {
      position: static;
      width: auto;
      max-height: none;
      box-shadow: none;
    }

    .blog-post-share__sheet-bar,
    .blog-post-share__sheet-actions,
    .blog-post-share__sheet::backdrop {
      display: none !important;
    }

    .blog-post-share__document {
      max-height: none;
      overflow: visible;
      padding: 0;
    }
  }
{% endstylesheet %}

{% javascript %}
  function formattedShareText(documentEl) {
    if (!documentEl) return '';
    return documentEl.innerText.replace(/[ \t]+\n/g, '\n').replace(/\n{3,}/g, '\n\n').trim();
  }

  function copyShareVariables(targetDoc) {
    var source = getComputedStyle(document.documentElement);
    ['--font-body--family', '--font-heading--family', '--font-accent--family'].forEach(function (name) {
      var value = source.getPropertyValue(name);
      if (value) targetDoc.documentElement.style.setProperty(name, value);
    });
  }

  function printShareDocument(sheet, documentEl, title) {
    if (!documentEl) return;
    var iframe = document.createElement('iframe');
    iframe.setAttribute('aria-hidden', 'true');
    iframe.style.cssText = 'position:fixed;right:0;bottom:0;width:0;height:0;border:0;';
    document.body.appendChild(iframe);
    var frameDoc = iframe.contentDocument;
    frameDoc.title = title || document.title;
    var style = frameDoc.createElement('style');
    var printCss = sheet.querySelector('.blog-post-share__print-css');
    style.textContent = printCss ? printCss.textContent : '';
    frameDoc.head.appendChild(style);
    copyShareVariables(frameDoc);
    frameDoc.body.appendChild(documentEl.cloneNode(true));
    var cleanup = function () {
      iframe.remove();
    };
    iframe.contentWindow.addEventListener('afterprint', cleanup);
    iframe.contentWindow.focus();
    iframe.contentWindow.print();
    setTimeout(cleanup, 1500);
  }

  function bindShareSheet(container) {
    var sheet = container.querySelector('.blog-post-share__sheet');
    if (!sheet || sheet.dataset.bound === 'true') return;
    sheet.dataset.bound = 'true';
    var documentEl = sheet.querySelector('.blog-post-share__document');
    var nativeButton = sheet.querySelector('[data-share-native]');
    var copyButton = sheet.querySelector('[data-share-copy]');
    var printButton = sheet.querySelector('[data-share-print-sheet]');
    var closeButton = sheet.querySelector('[data-share-close]');
    var shareButton = container.querySelector('.blog-post-share__button[data-share-url]');
    var title = (shareButton && shareButton.dataset.shareTitle) || document.title;
    var url = (shareButton && shareButton.dataset.shareUrl) || window.location.href;

    if (nativeButton && navigator.share) nativeButton.hidden = false;

    var openSheet = function () {
      if (!sheet.open) sheet.showModal();
    };

    var shareNative = async function () {
      if (!navigator.share) return false;
      try {
        await navigator.share({
          title: title,
          text: formattedShareText(documentEl),
          url: url
        });
        return true;
      } catch (error) {
        if (error.name === 'AbortError') return true;
        return false;
      }
    };

    var copyText = async function (button) {
      var label = button.querySelector('.blog-post-share__label') || button;
      var originalLabel = label.textContent;
      var copiedLabel = button.dataset.copiedLabel;
      try {
        await navigator.clipboard.writeText(formattedShareText(documentEl));
        if (copiedLabel) {
          label.textContent = copiedLabel;
          setTimeout(function () {
            label.textContent = originalLabel;
          }, 2000);
        }
      } catch (error) {
        window.prompt(title, formattedShareText(documentEl));
      }
    };

    sheet.addEventListener('click', function (event) {
      if (event.target === sheet) sheet.close();
    });
    if (closeButton) closeButton.addEventListener('click', function () { sheet.close(); });
    if (copyButton) copyButton.addEventListener('click', function () { copyText(copyButton); });
    if (printButton) printButton.addEventListener('click', function () { printShareDocument(sheet, documentEl, title); });
    if (nativeButton) nativeButton.addEventListener('click', function () { shareNative(); });

    container.querySelectorAll('.blog-post-share__button[data-share-url]').forEach(function (button) {
      if (button.dataset.bound === 'true') return;
      button.dataset.bound = 'true';
      button.addEventListener('click', function () { openSheet(); });
    });

    container.querySelectorAll('.blog-post-share__button[data-print]').forEach(function (button) {
      if (button.dataset.bound === 'true') return;
      button.dataset.bound = 'true';
      button.addEventListener('click', function () {
        openSheet();
        printShareDocument(sheet, documentEl, title);
      });
    });
  }

  function bindBlogPostShare(root) {
    if (!root) root = document;
    root.querySelectorAll('.blog-post-share').forEach(function (container) {
      bindShareSheet(container);
    });
  }

  bindBlogPostShare();
  document.addEventListener('shopify:section:load', function (event) {
    bindBlogPostShare(event.target);
  });
{% endjavascript %}

