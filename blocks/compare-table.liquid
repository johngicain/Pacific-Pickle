

{% assign block_settings = block.settings %}

<div
  class="ppw-compare spacing-style"
  style="
    --compare-header-bg: {{ block_settings.header_background }};
    --compare-header-text: {{ block_settings.header_text }};
    --compare-ours: {{ block_settings.ours_color }};
    --compare-stripe: {{ block_settings.stripe_color }};
    --compare-row: {{ block_settings.row_color }};
    --compare-border: {{ block_settings.border_color }};
    --compare-border-width: {{ block_settings.border_width }}px;
    --compare-border-style: {{ block_settings.border }};
    --compare-feature-max-width: {{ block_settings.feature_max_width }}%;
    {% render 'compare-table-header-style', settings: block_settings %}
    {% render 'spacing-style', settings: block_settings %}
  "
  {{ block.shopify_attributes }}
>
  <table>
    <thead>
      <tr>
        <th
          scope="col"
          style="
            --compare-cell-align: {{ block_settings.header_feature_alignment }};
            {% if block_settings.header_feature_color != blank -%}
              --compare-cell-color: {{ block_settings.header_feature_color }};
            {% endif -%}
            {% if block_settings.header_feature_background != blank -%}
              --compare-cell-bg: {{ block_settings.header_feature_background }};
            {% endif -%}
          "
        >
          {{ block_settings.feature_heading }}
        </th>
        <th
          scope="col"
          style="
            --compare-cell-align: {{ block_settings.header_ours_alignment }};
            {% if block_settings.header_ours_color != blank -%}
              --compare-cell-color: {{ block_settings.header_ours_color }};
            {% endif -%}
            {% if block_settings.header_ours_background != blank -%}
              --compare-cell-bg: {{ block_settings.header_ours_background }};
            {% endif -%}
          "
        >
          {{ block_settings.ours_heading }}
        </th>
        <th
          scope="col"
          style="
            --compare-cell-align: {{ block_settings.header_theirs_alignment }};
            {% if block_settings.header_theirs_color != blank -%}
              --compare-cell-color: {{ block_settings.header_theirs_color }};
            {% endif -%}
            {% if block_settings.header_theirs_background != blank -%}
              --compare-cell-bg: {{ block_settings.header_theirs_background }};
            {% endif -%}
          "
        >
          {{ block_settings.theirs_heading }}
        </th>
      </tr>
    </thead>
    <tbody>
      {% content_for 'blocks' %}
    </tbody>
  </table>
</div>

{% render 'compare-table-styles' %}

