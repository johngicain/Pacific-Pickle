

{%- doc -%}
  This block is used to display the add to cart button.
  Intended for product-form.liquid block.

  @param {string} can_add_to_cart - Whether the product can be added to the cart
  @param {string} add_to_cart_text - The text of the add to cart button
{%- enddoc -%}

{% liquid
  assign scoped_class = block.settings.style_class | append: '--' | append: block.id
  assign class = 'add-to-cart-button ' | append: block.settings.style_class | append: ' ' | append: scoped_class
  if block.settings.box_shadow
    assign class = class | append: ' button--box-shadow'
  endif
  assign show_atc_icon = false
  assign icon_display = 'none'
  if can_add_to_cart
    if block.settings.show_icon
      assign show_atc_icon = true
      assign icon_display = 'flex'
    else
      assign class = class | append: ' add-to-cart-button--hide-icon'
    endif
  endif
  assign id = 'BuyButtons-ProductSubmitButton-' | append: block.id | append: '-' | append: closest.product.id
  assign button_style = ''
  if block.settings.font_size != blank
    assign button_style = '--button-font-size: ' | append: block.settings.font_size | append: '; font-size: ' | append: block.settings.font_size
  endif
  assign atc_font_styles = ''
  if block.settings.font != blank
    assign atc_font_styles = atc_font_styles | append: '--add-to-cart-font-family: ' | append: block.settings.font | append: ';'
  endif
  if block.settings.weight != blank
    assign atc_font_styles = atc_font_styles | append: '--add-to-cart-font-weight: ' | append: block.settings.weight | append: ';'
  endif
  if block.settings.font_size != blank
    assign atc_font_styles = atc_font_styles | append: '--add-to-cart-font-size: ' | append: block.settings.font_size | append: ';'
  endif
  if block.settings.letter_spacing != blank
    assign atc_font_styles = atc_font_styles | append: '--add-to-cart-letter-spacing: var(--letter-spacing--body-' | append: block.settings.letter_spacing | append: ');'
  endif
  if block.settings.case != blank
    assign atc_font_styles = atc_font_styles | append: '--add-to-cart-font-case: ' | append: block.settings.case | append: ';'
  endif
%}
{% render 'button-custom-styles', block_settings: block.settings, block_id: block.id %}
{% render 'add-to-cart-button-styles' %}
{% render 'fly-to-cart-styles' %}

<span
  {{ block.shopify_attributes }}
  style="--add-to-cart-icon-display: {{ icon_display }}; {{ atc_font_styles }}"
>
  {% render 'add-to-cart-button',
    id: id,
    class: class,
    can_add_to_cart: can_add_to_cart,
    show_icon: show_atc_icon,
    product: closest.product,
    add_to_cart_text: add_to_cart_text,
    show_price: true,
    data_testid: 'standalone-add-to-cart',
    style: button_style
  %}
</span>

