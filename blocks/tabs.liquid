{% liquid
  assign block_settings = block.settings

  if block_settings.background_color != blank
    render 'contrast-override', background_color: block_settings.background_color, text_color: block_settings.text_color, section_id: block.id
  endif
%}

{% capture items %}
  {% content_for 'blocks' %}
{% endcapture %}

<div
  class="tabs-block spacing-style{% if block_settings.background_color != blank %} color-custom-{{ block.id }}{% endif %}"
  style="{% render 'spacing-style', settings: block_settings %}"
  {{ block.shopify_attributes }}
>
  {% render 'tabs',
    items: items,
    settings: block_settings,
    id: block.id
  %}
</div>

{% stylesheet %}
  .tabs-block {
    width: 100%;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.tabs",
  "tag": null,
  "class": "tabs-block",
  "blocks": [
    {
      "type": "_tab"
    }
  ],
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:settings.heading"
    },
    {
      "type": "text_alignment",
      "id": "heading_alignment",
      "label": "t:settings.alignment",
      "default": "left",
      "visible_if": "{{ block.settings.heading != blank }}"
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "tab_style",
      "label": "t:settings.style",
      "options": [
        {
          "value": "underline",
          "label": "t:options.underline"
        },
        {
          "value": "pills",
          "label": "t:options.pills"
        },
        {
          "value": "boxed",
          "label": "t:options.boxed"
        }
      ],
      "default": "underline"
    },
    {
      "type": "select",
      "id": "tab_alignment",
      "label": "t:settings.alignment",
      "options": [
        {
          "value": "start",
          "label": "t:options.left"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "fill",
          "label": "t:options.fill"
        }
      ],
      "default": "start"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 48,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "content_padding",
      "label": "t:settings.content_padding",
      "min": 0,
      "max": 80,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "select",
      "id": "panel_max_width",
      "label": "t:settings.max_width",
      "options": [
        {
          "value": "none",
          "label": "t:options.none"
        },
        {
          "value": "custom",
          "label": "t:options.custom"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "panel_custom_max_width",
      "label": "t:settings.custom_width",
      "min": 200,
      "max": 1200,
      "step": 10,
      "unit": "px",
      "default": 720,
      "visible_if": "{{ block.settings.panel_max_width == 'custom' }}"
    },
    {
      "type": "header",
      "content": "t:content.typography"
    },
    {
      "type": "select",
      "id": "type_preset",
      "label": "t:settings.heading_preset",
      "options": [
        {
          "value": "",
          "label": "t:options.default"
        },
        {
          "value": "paragraph",
          "label": "t:options.paragraph"
        },
        {
          "value": "h1",
          "label": "t:options.h1"
        },
        {
          "value": "h2",
          "label": "t:options.h2"
        },
        {
          "value": "h3",
          "label": "t:options.h3"
        },
        {
          "value": "h4",
          "label": "t:options.h4"
        },
        {
          "value": "h5",
          "label": "t:options.h5"
        },
        {
          "value": "h6",
          "label": "t:options.h6"
        },
        {
          "value": "custom",
          "label": "t:options.custom"
        }
      ],
      "default": "h6",
      "info": "t:info.edit_presets_in_theme_settings"
    },
    {
      "type": "select",
      "id": "font",
      "label": "t:settings.font",
