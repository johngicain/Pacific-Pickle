{% liquid
  assign block_settings = block.settings
  assign tips = block_settings.content
  if tips == blank
    assign tips = article.metafields.custom.pro_tips.value
  endif
  if tips == blank
    assign tips = article.metafields.custom.pro_tips | metafield_tag
  endif
%}

{% if tips != blank or request.design_mode %}
  <div
    class="blog-post-pro-tips spacing-style"
    style="
      {% render 'spacing-style', settings: block_settings %}
      {% if block_settings.heading_color != blank %}
        --blog-post-pro-tips-heading: {{ block_settings.heading_color }};
      {% endif %}
      {% if block_settings.accent_color != blank %}
        --blog-post-pro-tips-accent: {{ block_settings.accent_color }};
      {% endif %}
      {% if block_settings.text_color != blank %}
        --blog-post-pro-tips-text: {{ block_settings.text_color }};
      {% endif %}
    "
    {{ block.shopify_attributes }}
  >
    {% if block_settings.heading != blank %}
      <h2 class="blog-post-pro-tips__heading">{{ block_settings.heading }}</h2>
    {% endif %}
    <div class="blog-post-pro-tips__body rte">
      {% if tips != blank %}
        {{ tips }}
      {% elsif request.design_mode %}
        <ul>
          <li>{{ 'blogs.article.pro_tip_placeholder' | t }}</li>
        </ul>
      {% endif %}
    </div>
  </div>
{% endif %}

{% stylesheet %}
  .blog-post-pro-tips {
    width: 100%;
  }

  .blog-post-pro-tips__heading {
    margin: 0 0 1rem;
    font-family: var(--font-heading--family);
    font-size: 0.875rem;
    font-weight: 900;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--blog-post-pro-tips-heading, var(--color-foreground));
  }

  .blog-post-pro-tips__body {
    color: var(--blog-post-pro-tips-text, var(--color-foreground));
  }

  .blog-post-pro-tips__body ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .blog-post-pro-tips__body li,
  .blog-post-pro-tips__body p {
    position: relative;
    margin: 0 0 0.75rem;
    padding-left: 1.5rem;
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  .blog-post-pro-tips__body li::before,
  .blog-post-pro-tips__body p::before {
    content: '→';
    position: absolute;
    left: 0;
    color: var(--blog-post-pro-tips-accent, #e8821a);
    font-weight: 700;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.pro_tips",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "t:text_defaults.pro_tips"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "t:settings.content"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "t:settings.heading_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "t:settings.highlight_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:settings.text_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:names.pro_tips",
      "category": "t:categories.blog_post"
    }
  ]
}
{% endschema %}
