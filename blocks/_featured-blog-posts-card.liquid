{%- doc -%}
  Renders a featured blog post card for resource lists.

  @param {object} [article] - The article to render
{%- enddoc -%}

{% assign block_settings = block.settings %}

{% liquid
  assign onboarding = false

  if article == blank
    assign onboarding = true
    assign display_title = 'placeholders.blog_post_title' | t
  else
    assign display_title = article.title
  endif

  if block_settings.background_color != blank
    render 'contrast-override', background_color: block_settings.background_color, section_id: block.id
  endif
%}

<div
  class="
    featured-blog-posts-card spacing-style border-style
    {% if section.settings.layout_type == 'editorial' %}blog-post-card--flexible-aspect-ratio{% endif %}
    {% if block_settings.background_color != blank %}color-custom-{{ block.id }}{% endif %}
    {% if block_settings.box_shadow %}featured-blog-posts-card--box-shadow{% endif %}
    {% if block_settings.lift_on_hover %}featured-blog-posts-card--hover-lift{% endif %}
    {% if block_settings.zoom_image_on_hover %}featured-blog-posts-card--hover-zoom{% endif %}
  "
  data-block-id="{{ block.id }}"
  data-testid="featured-blog-posts-card"
  {% if onboarding %}
    data-placeholder="true"
  {% endif %}
  style="
    {%- render 'spacing-style', settings: block_settings -%}
    {%- render 'border-override', settings: block_settings -%}
    --text-align: {{ block_settings.alignment }};
    --horizontal-alignment: {{ block_settings.alignment }};
    --gap: {{ block_settings.gap }}px;
    {% if block_settings.box_shadow %}
      --product-card-box-shadow: 3px 3px var(--color-foreground);
    {% endif %}
  "
  {{ block.shopify_attributes }}
>
  <a
    class="featured-blog-posts-card__link"
    {% unless onboarding %}
      href="{{ article.url }}"
    {% endunless %}
  >
    <span class="visually-hidden">{{ display_title }}</span>
  </a>

  <div class="featured-blog-posts-card__inner featured-blog-posts-card__content layout-panel-flex--column">
    {% content_for 'blocks', closest.article: article %}
  </div>
</div>

{% stylesheet %}
  .featured-blog-posts-card {
    width: 100%;
    position: relative;
    height: 100%;
    text-align: var(--text-align);
    box-shadow: var(--product-card-box-shadow, none);
  }

  .featured-blog-posts-card--hover-lift {
    top: 0;
    transition: top var(--hover-transition-duration) var(--hover-transition-timing);
  }

  .featured-blog-posts-card--hover-zoom .resource-image__image,
  .featured-blog-posts-card--hover-zoom .blog-placeholder-svg {
    transform-origin: center;
    transition: transform var(--hover-transition-duration) var(--hover-transition-timing);
  }

  @media (any-pointer: fine) and (prefers-reduced-motion: no-preference) {
    .featured-blog-posts-card--hover-lift:hover {
      top: -5px;
      z-index: var(--layer-raised);
    }

    .featured-blog-posts-card--hover-zoom:hover .resource-image__image,
    .featured-blog-posts-card--hover-zoom:hover .blog-placeholder-svg {
      transform: scale(var(--product-card-hover-image-zoom, 1.08));
    }
  }

  .featured-blog-posts-card__inner {
    width: 100%;
    overflow: hidden;
    position: relative;
    display: flex;
    flex-direction: column;
    z-index: var(--layer-flat);
    pointer-events: none;
    gap: var(--gap);
  }

  .featured-blog-posts-card__link {
    position: absolute;
    inset: 0;

    /* allows focus outline to have radius in supported browsers */
    border-radius: var(--border-radius);
  }

  .resource-list--grid .resource-list__item {
    min-width: 0;
  }

  /* Editorial layout */
  .resource-list:not(.hidden--desktop) .blog-post-card--flexible-aspect-ratio {
    .featured-blog-posts-card__image,
    .blog-placeholder-svg {
      aspect-ratio: 99;
      height: 100%;
    }

    .featured-blog-posts-card__inner {
      display: flex;
      flex-direction: column;
      height: 100%;
    }

    .featured-blog-posts-card__content {
      --flex-wrap: nowrap;
    }
  }

  @media screen and (max-width: 749px) {
    .resource-list:not(.hidden--desktop) .blog-post-card--flexible-aspect-ratio {
      .featured-blog-posts-card__image,
      .blog-placeholder-svg {
        aspect-ratio: unset;
      }
    }
  }

  .featured-blog-posts-card__inner a,
  .featured-blog-posts-card__inner button {
    pointer-events: auto;
  }

  /* allow all blocks to be selectable in editor preview */
  .shopify-design-mode .featured-blog-posts-card__inner * {
    pointer-events: auto;
  }

  .featured-blog-posts-card__content {
    /* --flex-wrap: wrap; */

    display: flex;
    position: relative;
    height: 100%;
    width: 100%;
    gap: var(--gap);
  }

  .featured-blog-posts-card .text-block:is(.h1, .h2, .h3, .h4, .h5, .h6) {
    min-width: 0;
    max-width: 100%;
    width: 100%;
  }

  .featured-blog-posts-card .text-block:is(.h1, .h2, .h3, .h4, .h5, .h6) > *,
  .featured-blog-posts-card .text-block :is(h1, h2, h3, h4, h5, h6) {
    margin: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-inline-size: 100%;
    width: 100%;
  }

  .featured-blog-posts-card .blog-post-card__content-text,
  .featured-blog-posts-card .text-block:not(:is(.h1, .h2, .h3, .h4, .h5, .h6)) {
    min-width: 0;
    max-width: 100%;
    flex-shrink: 0;
  }

  .featured-blog-posts-card .blog-post-card__content-text,
  .featured-blog-posts-card .text-block:not(:is(.h1, .h2, .h3, .h4, .h5, .h6)) > * {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-overflow: ellipsis;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    max-inline-size: 100%;
    width: 100%;
    text-wrap: unset;
  }

  .featured-blog-posts-card a.button-unstyled {
    font-weight: var(--button-font-weight, inherit);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.blog_card",
  "tag": null,
  "blocks": [
    {
      "type": "_featured-blog-posts-image"
    },
    {
      "type": "_heading"
    },
    {
      "type": "_blog-post-info-text"
    },
    {
      "type": "_blog-post-description"
    },
    {
      "type": "@theme"
    },
    {
      "type": "text"
    },
    {
      "type": "button"
    },
    {
      "type": "group"
    },
    {
      "type": "spacer"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "t:content.text"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "t:settings.alignment",
      "options": [
        {
          "value": "left",
          "label": "t:options.left"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "right",
          "label": "t:options.right"
        }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.vertical_gap",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "select",
      "id": "border",
      "label": "t:settings.borders",
      "options": [
        {
          "value": "none",
          "label": "t:options.none"
        },
        {
          "value": "solid",
          "label": "t:options.solid"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "border_width",
      "min": 0,
      "max": 10,
      "step": 0.5,
      "unit": "px",
      "label": "t:settings.border_width",
      "default": 1,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "t:settings.opacity",
      "default": 100,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "t:settings.color",
      "placeholder": "t:settings.default",
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "t:settings.border_radius",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "box_shadow",
      "label": "t:settings.box_shadow",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "lift_on_hover",
      "label": "t:settings.lift_on_hover",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "zoom_image_on_hover",
      "label": "t:settings.zoom_image_on_hover",
      "default": true
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ]
}
{% endschema %}
