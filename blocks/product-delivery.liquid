{% liquid
  assign block_settings = block.settings

  assign days_source = block_settings.days | strip_html | strip
  assign delivery_days = 3
  if days_source != blank
    assign delivery_days = days_source | plus: 0 | at_least: 0
  endif
  assign offset_seconds = delivery_days | times: 86400
  assign now_ts = 'now' | date: '%s' | plus: 0
  assign delivery_ts = now_ts | plus: offset_seconds
  assign delivery_weekday = delivery_ts | date: '%A'
  assign delivery_month = delivery_ts | date: '%b'
  assign delivery_day_number = delivery_ts | date: '%e' | strip
  assign delivery_date = delivery_weekday | append: ', ' | append: delivery_month | append: ' ' | append: delivery_day_number
  assign delivery_datetime = delivery_ts | date: '%Y-%m-%d'
  assign prefix_text = block_settings.text

  assign type_preset = block_settings.type_preset | default: 'paragraph'
  assign delivery_classes = 'product-delivery product-delivery--' | append: block.id
  assign text_type = 'body'

  if type_preset == 'custom'
    assign delivery_classes = delivery_classes | append: ' custom-typography'
  elsif type_preset != blank
    assign delivery_classes = delivery_classes | append: ' ' | append: type_preset
  endif

  if block_settings.weight != blank
    assign delivery_classes = delivery_classes | append: ' custom-font-weight'
  endif

  if block_settings.font_size != blank
    assign delivery_classes = delivery_classes | append: ' custom-font-size'
    assign font_size_value = block_settings.font_size | split: 'rem' | first | times: 1.0
    if font_size_value >= 3
      assign text_type = 'display'
    elsif font_size_value >= 1.25
      assign text_type = 'heading'
    endif
  endif

  assign delivery_classes = delivery_classes | append: ' spacing-style border-style'
  if block_settings.background_color != blank or block_settings.text_color != blank
    assign delivery_classes = delivery_classes | append: ' color-custom-' | append: block.id
  endif

  assign max_width = 'fit-content'
  if block_settings.max_width == 'custom'
    assign delivery_classes = delivery_classes | append: ' product-delivery--custom-max-width'
    assign max_width = block_settings.custom_max_width | append: '%'
  endif
%}

{% if block_settings.background_color != blank or block_settings.text_color != blank %}
  {% render 'contrast-override',
    background_color: block_settings.background_color,
    text_color: block_settings.text_color,
    border_color: block_settings.border_color,
    section_id: block.id
  %}
{% endif %}

<div
  class="{{ delivery_classes }}"
  data-block-id="{{ block.id }}"
  style="
    {% render 'typography-style', settings: block_settings, preset: type_preset, type: text_type %}
    {% render 'spacing-style', settings: block_settings %}
    {% render 'border-override', settings: block_settings %}
    --product-delivery-icon-size: {{ block_settings.icon_size }}px;
    --product-delivery-gap: {{ block_settings.gap }}px;
    {% if block_settings.icon_color != blank %}
      --product-delivery-icon-color: {{ block_settings.icon_color }};
    {% endif %}
    {% if block_settings.font_size != blank %}
      --font-size: {{ block_settings.font_size }};
      --product-delivery-font-size: {{ block_settings.font_size }};
    {% endif %}
    {% if block_settings.weight != blank %}
      --font-weight: {{ block_settings.weight }};
    {% endif %}
    {% if block_settings.text_color != blank %}
      --color: {{ block_settings.text_color }};
    {% endif %}
    {% if block_settings.date_color != blank %}
      --product-delivery-date-color: {{ block_settings.date_color }};
    {% endif %}
    --product-delivery-max-width: {{ max_width }};
  "
  role="status"
  aria-label="{{ 'accessibility.product_delivery' | t: date: delivery_date }}"
  {{ block.shopify_attributes }}
>
  {% if block_settings.show_icon %}
    <span class="product-delivery__icon" aria-hidden="true">
      {{ 'icon-truck.svg' | inline_asset_content }}
    </span>
  {% endif %}
  <span class="product-delivery__value">
    {% if prefix_text != blank %}
      <span class="product-delivery__text">{{ prefix_text }}</span>
    {% endif %}
    <time
      class="product-delivery__date"
      datetime="{{ delivery_datetime }}"
    >
      {{- delivery_date -}}
    </time>
  </span>
</div>

{% stylesheet %}
  .product-delivery {
    display: inline-flex;
    align-items: center;
    gap: var(--product-delivery-gap, 8px);
    width: fit-content;
    max-width: var(--product-delivery-max-width, 100%);
    color: var(--color, inherit);
    box-sizing: border-box;
    font-weight: var(--font-weight, 600);
  }

  .product-delivery--custom-max-width {
    width: 100%;
  }

  .product-delivery__icon,
  .product-delivery__icon svg {
    display: block;
    flex-shrink: 0;
    width: var(--product-delivery-icon-size, 16px);
    height: var(--product-delivery-icon-size, 16px);
    color: var(--product-delivery-icon-color, #3d6b35);
  }

  .product-delivery__value {
    min-width: 0;
    font-weight: inherit;
  }

  .product-delivery__text,
  .product-delivery__text * {
    font-weight: inherit;
    font-size: inherit;
    color: inherit;
  }

  .product-delivery__text:not(:empty)::after {
    content: '\00a0';
  }

  .product-delivery__date {
    white-space: nowrap;
    font-weight: inherit;
    color: var(--product-delivery-date-color, inherit);
  }

  .product-delivery--custom-max-width .product-delivery__value,
  .product-delivery--custom-max-width .product-delivery__date {
    white-space: normal;
  }

  .product-delivery.custom-font-size,
  .product-delivery.custom-font-size .product-delivery__value,
  .product-delivery.custom-font-size .product-delivery__text,
  .product-delivery.custom-font-size .product-delivery__date {
    font-size: var(--product-delivery-font-size, var(--font-size));
  }

  .product-delivery.custom-font-weight,
  .product-delivery.custom-font-weight .product-delivery__value,
  .product-delivery.custom-font-weight .product-delivery__text,
  .product-delivery.custom-font-weight .product-delivery__date {
    font-weight: var(--font-weight, 600);
  }
{% endstylesheet %}

