{% liquid
  assign block_settings = block.settings
  assign product = closest.product

  if request.visual_preview_mode and product == blank
    assign product = collections.all.products.first
  endif

  assign selected_metaobjects = block_settings.metaobjects
  assign selected_count = 0
  if selected_metaobjects != blank
    for item in selected_metaobjects limit: 3
      assign object_handle = item.system.handle
      if object_handle == blank
        assign object_handle = item.handle
      endif
      if object_handle != blank
        assign selected_count = selected_count | plus: 1
      endif
    endfor
  endif

  assign product_feature_1 = product.metafields.custom.features.value
  if product_feature_1.system.handle != blank
    assign fetched_feature = metaobjects[product_feature_1.system.type][product_feature_1.system.handle]
    if fetched_feature != blank
      assign product_feature_1 = fetched_feature
    endif
  endif
  assign product_feature_2 = product.metafields.custom.feature_2.value
  if product_feature_2.system.handle != blank
    assign fetched_feature = metaobjects[product_feature_2.system.type][product_feature_2.system.handle]
    if fetched_feature != blank
      assign product_feature_2 = fetched_feature
    endif
  endif
  assign product_feature_3 = product.metafields.custom.feature_3.value
  if product_feature_3.system.handle != blank
    assign fetched_feature = metaobjects[product_feature_3.system.type][product_feature_3.system.handle]
    if fetched_feature != blank
      assign product_feature_3 = fetched_feature
    endif
  endif
  assign product_feature_count = 0
  if product_feature_1 != blank
    assign product_feature_count = product_feature_count | plus: 1
  endif
  if product_feature_2 != blank
    assign product_feature_count = product_feature_count | plus: 1
  endif
  if product_feature_3 != blank
    assign product_feature_count = product_feature_count | plus: 1
  endif

  assign items_source = 'none'
  assign loop_count = 0
  assign column_items = 0
  if selected_count > 0
    assign items_source = 'settings'
    assign loop_count = selected_count
    assign column_items = selected_count
  elsif product_feature_count > 0
    assign items_source = 'product'
    assign loop_count = 3
    assign column_items = product_feature_count
  elsif request.visual_preview_mode or request.design_mode
    assign items_source = 'placeholder'
    assign loop_count = 3
    assign column_items = 3
  endif

  assign display_mode = block_settings.display_mode | default: 'icon_text'

  assign desktop_columns = block_settings.columns | plus: 0
  if column_items < desktop_columns
    assign desktop_columns = column_items
  endif
  if desktop_columns < 1
    assign desktop_columns = 1
  endif

  assign mobile_columns = block_settings.mobile_columns | plus: 0
  if column_items < mobile_columns
    assign mobile_columns = column_items
  endif
  if mobile_columns < 1
    assign mobile_columns = 1
  endif

  case block_settings.alignment
    when 'center'
      assign align_items = 'center'
      assign text_align = 'center'
    when 'right'
      assign align_items = 'flex-end'
      assign text_align = 'end'
    else
      assign align_items = 'flex-start'
      assign text_align = 'start'
  endcase

  assign item_class = 'details-multicolumn__item border-style'
  if block_settings.background_color != blank
    assign item_class = item_class | append: ' color-custom-' | append: block.id
  endif
  if block_settings.box_shadow
    assign item_class = item_class | append: ' details-multicolumn__item--shadow'
  endif
%}

{% if loop_count > 0 %}
  {% if block_settings.background_color != blank %}
    {% render 'contrast-override',
      background_color: block_settings.background_color,
      text_color: block_settings.text_color,
      border_color: block_settings.border_color,
      section_id: block.id
    %}
  {% endif %}

  {% if block_settings.text_color != blank %}
    {% style %}
      .details-multicolumn--{{ block.id }} {
        --details-multicolumn-text-color: {{ block_settings.text_color }};
        --color: {{ block_settings.text_color }};
      }
    {% endstyle %}
  {% endif %}

  <div
    class="
      details-multicolumn
      details-multicolumn--{{ block.id }}
      details-multicolumn--{{ display_mode }}
      spacing-style
    "
    style="
      {% render 'spacing-style', settings: block_settings %}
      --details-multicolumn-columns: {{ desktop_columns }};
      --details-multicolumn-columns-mobile: {{ mobile_columns }};
      --details-multicolumn-gap: {{ block_settings.columns_gap }}px;
      --details-multicolumn-item-gap: {{ block_settings.gap }}px;
      --details-multicolumn-image-width: {{ block_settings.image_width }}px;
      --details-multicolumn-align: {{ align_items }};
      --details-multicolumn-text-align: {{ text_align }};
      --details-multicolumn-item-padding-block-start: {{ block_settings.item_padding_top }}px;
      --details-multicolumn-item-padding-block-end: {{ block_settings.item_padding_bottom }}px;
      --details-multicolumn-item-padding-inline-start: {{ block_settings.item_padding_left }}px;
      --details-multicolumn-item-padding-inline-end: {{ block_settings.item_padding_right }}px;
      --border-radius: {{ block_settings.border_radius }}px;
      {% if block_settings.enable_border %}
        --border-width: {{ block_settings.border_width }}px;
        --border-style: {{ block_settings.border | default: 'solid' }};
        --border-color:
        {% if block_settings.border_color != blank %}
          rgb({{ block_settings.border_color.rgba }})
        {% else %}
          rgb(var(--color-border-rgb) / {{ block_settings.border_opacity | divided_by: 100.0 }})
        {% endif %}
        ;
      {% else %}
        --border-width: 0px;
        --border-style: none;
      {% endif %}
    "
    {{ block.shopify_attributes }}
  >
    {% if items_source == 'settings' %}
      {% for raw_item in selected_metaobjects limit: 3 %}
        {% liquid
          assign item = raw_item
          assign object_type = raw_item.system.type
          assign object_handle = raw_item.system.handle
          if object_type == blank
            assign object_type = 'features'
          endif
          if object_handle == blank
            assign object_handle = raw_item.handle
          endif
          if object_handle != blank
            assign fetched = metaobjects[object_type][object_handle]
            if fetched != blank
              assign item = fetched
            endif
          endif
        %}
        {% if item != blank %}
          {% render 'details-multicolumn-item',
            item: item,
            display_mode: display_mode,
            block_settings: block_settings,
            item_class: item_class
          %}
        {% endif %}
      {% endfor %}
    {% elsif items_source == 'product' %}
      {% if product_feature_1 != blank %}
          {% render 'details-multicolumn-item',
            item: product_feature_1,
            display_mode: display_mode,
            block_settings: block_settings,
            item_class: item_class
          %}
      {% endif %}
      {% if product_feature_2 != blank %}
          {% render 'details-multicolumn-item',
            item: product_feature_2,
            display_mode: display_mode,
            block_settings: block_settings,
            item_class: item_class
          %}
      {% endif %}
      {% if product_feature_3 != blank %}
          {% render 'details-multicolumn-item',
            item: product_feature_3,
            display_mode: display_mode,
            block_settings: block_settings,
            item_class: item_class
          %}
      {% endif %}
    {% else %}
      {% render 'details-multicolumn-item',
        show_placeholder: true,
        placeholder_heading: 'Non-GMO',
        placeholder_text: 'Project Verified',
        display_mode: display_mode,
        block_settings: block_settings,
        item_class: item_class
      %}
      {% render 'details-multicolumn-item',
        show_placeholder: true,
        placeholder_heading: 'Gluten-Free',
        placeholder_text: 'Naturally',
        display_mode: display_mode,
        block_settings: block_settings,
        item_class: item_class
      %}
      {% render 'details-multicolumn-item',
        show_placeholder: true,
        placeholder_heading: 'Hand-Packed',
        placeholder_text: 'Santa Barbara, CA',
        display_mode: display_mode,
        block_settings: block_settings,
        item_class: item_class
      %}
    {% endif %}
  </div>
{% endif %}

{% stylesheet %}
  .details-multicolumn {
    display: grid;
    grid-template-columns: repeat(var(--details-multicolumn-columns-mobile, 1), minmax(0, 1fr));
    gap: var(--details-multicolumn-gap, 12px);
    color: var(--details-multicolumn-text-color, inherit);
    width: 100%;
  }

  @media screen and (min-width: 750px) {
    .details-multicolumn {
      grid-template-columns: repeat(var(--details-multicolumn-columns, 3), minmax(0, 1fr));
    }
  }

  .details-multicolumn__item {
    display: flex;
    flex-direction: column;
    align-items: var(--details-multicolumn-align, flex-start);
    text-align: var(--details-multicolumn-text-align, start);
    gap: var(--details-multicolumn-item-gap, 6px);
    min-width: 0;
    box-sizing: border-box;
    padding-block-start: var(--details-multicolumn-item-padding-block-start, 0);
    padding-block-end: var(--details-multicolumn-item-padding-block-end, 0);
    padding-inline-start: var(--details-multicolumn-item-padding-inline-start, 0);
    padding-inline-end: var(--details-multicolumn-item-padding-inline-end, 0);
  }

  .details-multicolumn__item--shadow {
    box-shadow: 0 4px 16px rgb(var(--color-foreground-rgb) / var(--opacity-8));
  }

  .details-multicolumn__image {
    width: var(--details-multicolumn-image-width, 48px);
    height: auto;
    max-width: 100%;
    display: block;
    flex-shrink: 0;
  }

  .details-multicolumn__placeholder {
    height: var(--details-multicolumn-image-width, 48px);
  }

  .details-multicolumn__icon-text {
    font-size: var(--details-multicolumn-image-width, 48px);
    line-height: 1;
    display: block;
    flex-shrink: 0;
  }

  .details-multicolumn__heading {
    margin: 0;
  }

  .details-multicolumn__text > *:first-child {
    margin-block-start: 0;
  }

  .details-multicolumn__text > *:last-child {
    margin-block-end: 0;
  }
{% endstylesheet %}

