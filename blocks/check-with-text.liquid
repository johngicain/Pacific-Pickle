{% liquid
  assign block_settings = block.settings
  assign text = block_settings.text
  assign icon_style = block_settings.icon_style
  assign wrapper_tag = 'div'

  if block_settings.link != blank
    assign wrapper_tag = 'a'
  endif
%}

{% if block_settings.icon_color != blank or block_settings.icon_fill != blank or block_settings.text_color != blank %}
  {% style %}
    .check-with-text--{{ block.id }} {
      {% if block_settings.icon_color != blank %}
        --check-with-text-icon-color: {{ block_settings.icon_color }};
      {% endif %}
      {% if block_settings.icon_fill != blank %}
        --check-with-text-icon-fill: {{ block_settings.icon_fill }};
      {% endif %}
      {% if block_settings.text_color != blank %}
        --check-with-text-text-color: {{ block_settings.text_color }};
        --color: {{ block_settings.text_color }};
      {% endif %}
    }
  {% endstyle %}
{% endif %}

<{{ wrapper_tag }}
  class="
    check-with-text
    check-with-text--{{ block.id }}
    spacing-style
    {% if block_settings.link != blank %}check-with-text--link{% endif %}
  "
  style="
    {% render 'spacing-style', settings: block_settings %}
    --check-with-text-gap: {{ block_settings.gap }}px;
    --check-with-text-align: {{ block_settings.vertical_alignment }};
    --check-with-text-icon-size: {{ block_settings.width }}px;
    --check-with-text-width: {{ block_settings.block_width }};
  "
  {% if block_settings.link != blank %}
    href="{{ block_settings.link }}"
    {% if block_settings.open_in_new_tab %}
      target="_blank"
      rel="noopener noreferrer"
    {% endif %}
  {% endif %}
  {{ block.shopify_attributes }}
>
  <svg
    class="check-with-text__icon check-with-text__icon--{{ icon_style }}"
    aria-hidden="true"
    focusable="false"
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 20 20"
    width="{{ block_settings.width }}"
    height="{{ block_settings.width }}"
  >
    {% if icon_style != 'check' or block_settings.icon_fill != blank %}
      <circle
        class="check-with-text__shape"
        cx="10"
        cy="10"
        r="{% if icon_style == 'filled' %}9{% else %}8.25{% endif %}"
      />
    {% endif %}
    <path
      class="check-with-text__mark"
      d="{% if icon_style == 'check' and block_settings.icon_fill == blank %}M4.5 10.25L8.25 14L15.5 6.25{% else %}M6.25 10.25L8.75 12.75L13.75 7.5{% endif %}"
    />
  </svg>

  {% if text != blank or request.design_mode %}
    <p class="check-with-text__text {{ block_settings.type_preset }}">
      {{ text }}
    </p>
  {% endif %}
</{{ wrapper_tag }}>

{% stylesheet %}
  .check-with-text {
    display: flex;
    align-items: var(--check-with-text-align, center);
    gap: var(--check-with-text-gap, 8px);
    color: var(--check-with-text-text-color, inherit);
    width: var(--check-with-text-width, fit-content);
    max-width: 100%;
  }

  .check-with-text--link {
    color: inherit;
    text-decoration: none;
  }

  .check-with-text__icon {
    flex-shrink: 0;
    display: block;
    width: var(--check-with-text-icon-size, 20px);
    height: var(--check-with-text-icon-size, 20px);
    color: var(--check-with-text-icon-color, currentColor);
  }

  .check-with-text__shape {
    fill: var(--check-with-text-icon-fill, transparent);
    stroke: none;
  }

  .check-with-text__icon--circle .check-with-text__shape {
    stroke: var(--check-with-text-icon-fill, var(--check-with-text-icon-color, currentColor));
    stroke-width: 1.25;
  }

  .check-with-text__icon--filled .check-with-text__shape {
    fill: var(--check-with-text-icon-fill, var(--check-with-text-icon-color, currentColor));
  }

  .check-with-text__mark {
    fill: none;
    stroke: var(--check-with-text-icon-color, currentColor);
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .check-with-text__icon--check .check-with-text__mark {
    stroke-width: 1.75;
  }

  .check-with-text__icon--filled .check-with-text__mark {
    stroke: var(--check-with-text-icon-color, var(--color-background));
  }

  .check-with-text__text {
    margin: 0;
    min-width: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.check_with_text",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "t:settings.text",
      "default": "t:text_defaults.free_shipping"
    },
    {
      "type": "select",
      "id": "type_preset",
      "label": "t:settings.type_preset",
      "options": [
        {
          "value": "paragraph",
          "label": "t:options.paragraph"
        },
        {
          "value": "h4",
          "label": "t:options.h4"
        },
        {
          "value": "h5",
          "label": "t:options.h5"
        },
        {
          "value": "h6",
          "label": "t:options.h6"
        }
      ],
      "default": "paragraph"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:settings.text_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.icon"
    },
    {
      "type": "select",
      "id": "icon_style",
      "label": "t:settings.style",
      "options": [
        {
          "value": "check",
          "label": "t:options.check"
        },
        {
          "value": "circle",
          "label": "t:options.circle"
        },
        {
          "value": "filled",
          "label": "t:options.filled"
        }
      ],
      "default": "circle"
    },
    {
      "type": "range",
      "id": "width",
      "label": "t:settings.width",
      "min": 12,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "t:settings.color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "color",
      "id": "icon_fill",
      "label": "t:settings.fill",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "block_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "fit-content",
          "label": "t:options.fit"
        },
        {
          "value": "100%",
          "label": "t:options.fill"
        }
      ],
      "default": "fit-content"
    },
    {
      "type": "select",
      "id": "vertical_alignment",
      "label": "t:settings.alignment",
      "options": [
        {
          "value": "flex-start",
          "label": "t:options.top"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "flex-end",
          "label": "t:options.bottom"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "header",
      "content": "t:content.block_link"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:settings.link"
    },
    {
      "type": "checkbox",
      "id": "open_in_new_tab",
      "label": "t:settings.open_new_tab",
      "default": false
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:names.check_with_text",
      "category": "t:categories.basic",
      "settings": {
        "text": "t:text_defaults.free_shipping",
        "icon_style": "circle"
      }
    }
  ]
}
{% endschema %}
