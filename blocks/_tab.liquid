{% capture nested_blocks %}
  {% content_for 'blocks' %}
{% endcapture %}

{% liquid
  assign has_value = false

  capture tab_value
    render 'block-has-content-value', settings: block.settings
  endcapture
  if tab_value != blank
    assign has_value = true
  endif

  if nested_blocks contains 'metafield-'
    assign has_value = true
  endif
  if nested_blocks contains 'product-information-details__item'
    assign has_value = true
  endif
  if nested_blocks contains 'image-block__image'
    assign has_value = true
  endif
  if nested_blocks contains 'icon-with-text__text'
    assign has_value = true
  endif

  assign is_empty = false
  if has_value == false
    assign is_empty = true
  endif

  assign is_selected = false
  if is_empty == false and block.settings.open_by_default
    assign is_selected = true
  endif
%}

<div
  class="tabs__item{% if is_empty %} tabs__item--empty{% endif %}"
  {% if is_empty %}
    style="display: none;"
    hidden
  {% endif %}
  {{ block.shopify_attributes }}
>
  <button
    class="tabs__tab"
    type="button"
    role="tab"
    id="tab-{{ block.id }}"
    aria-controls="panel-{{ block.id }}"
    aria-selected="{% if is_selected %}true{% else %}false{% endif %}"
    tabindex="{% if is_selected %}0{% else %}-1{% endif %}"
  >
    {% if block.settings.heading != blank %}
      {{ block.settings.heading }}
    {% else %}
      {{ 'accessibility.tabs' | t }}
    {% endif %}
  </button>

  <div
    class="tabs__panel{% if is_selected %} is-active{% endif %}"
    id="panel-{{ block.id }}"
    role="tabpanel"
    aria-labelledby="tab-{{ block.id }}"
    tabindex="0"
  >
    {% if block.settings.content != blank %}
      <rte-formatter class="rte">
        {{ block.settings.content }}
      </rte-formatter>
    {% endif %}

    {{ nested_blocks }}
  </div>
</div>

{% schema %}
{
  "name": "t:names.tab",
  "tag": null,
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "t:text_defaults.tab_heading"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "t:settings.content",
      "default": "t:html_defaults.share_information_about_your"
    },
    {
      "type": "checkbox",
      "id": "open_by_default",
      "label": "t:settings.open_by_default",
      "default": false
    }
  ]
}
{% endschema %}
