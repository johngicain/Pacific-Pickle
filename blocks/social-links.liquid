
<div
  class="social-icons__wrapper social-icons__wrapper--{{ block.id }}"
  {{ block.shopify_attributes }}
>
  {% if block.settings.icon_color != blank %}
    {% style %}
      .social-icons__wrapper--{{ block.id }} {
        --color-utilities: {{ block.settings.icon_color }};
        color: {{ block.settings.icon_color }};
      }
    {% endstyle %}
  {% endif %}
  {% liquid
    assign social_links = 'facebook_url,instagram_url,youtube_url,tiktok_url,twitter_url,threads_url,linkedin_url,bluesky_url,snapchat_url,pinterest_url,tumblr_url,vimeo_url,custom_url' | split: ','
  %}

  {% for link_key in social_links %}
    {% liquid
      assign link_url = block.settings[link_key]
      assign label_key = link_key | replace: '_url', '_label'
      assign link_label = block.settings[label_key]

      if link_url != blank
        case link_key
          when 'facebook_url'
            assign platform = 'facebook'
            if link_label == blank
              assign link_label = 'Facebook'
            endif
          when 'instagram_url'
            assign platform = 'instagram'
            if link_label == blank
              assign link_label = 'Instagram'
            endif
          when 'youtube_url'
            assign platform = 'youtube'
            if link_label == blank
              assign link_label = 'YouTube'
            endif
          when 'tiktok_url'
            assign platform = 'tiktok'
            if link_label == blank
              assign link_label = 'TikTok'
            endif
          when 'twitter_url'
            assign platform = 'twitter'
            if link_label == blank
              assign link_label = 'X'
            endif
          when 'threads_url'
            assign platform = 'threads'
            if link_label == blank
              assign link_label = 'Threads'
            endif
          when 'linkedin_url'
            assign platform = 'linkedin'
            if link_label == blank
              assign link_label = 'LinkedIn'
            endif
          when 'bluesky_url'
            assign platform = 'bluesky'
            if link_label == blank
              assign link_label = 'Bluesky'
            endif
          when 'snapchat_url'
            assign platform = 'snapchat'
            if link_label == blank
              assign link_label = 'Snapchat'
            endif
          when 'pinterest_url'
            assign platform = 'pinterest'
            if link_label == blank
              assign link_label = 'Pinterest'
            endif
          when 'tumblr_url'
            assign platform = 'tumblr'
            if link_label == blank
              assign link_label = 'Tumblr'
            endif
          when 'vimeo_url'
            assign platform = 'vimeo'
            if link_label == blank
              assign link_label = 'Vimeo'
            endif
          when 'custom_url'
            assign platform = link_url | split: '//' | last | remove: 'www.' | split: '.' | first
            if link_label == blank
              assign link_label = platform | capitalize
            endif
        endcase

        assign url_parts = link_url | split: '//' | last | split: '/'
        assign has_profile = false

        if url_parts.size > 1 and url_parts[1] != ''
          assign has_profile = true
        endif

        if link_key == 'custom_url'
          assign has_profile = true
        endif
      endif
    %}

    {% if link_url != blank %}
      {% if request.design_mode or has_profile %}
        <div
          class="social-icons__icon-wrapper{% unless has_profile %} social-icons__icon-wrapper--disabled{% endunless %}"
        >
          <a
            href="{{ link_url }}"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="{{ link_label }}"
            {% unless has_profile %}
              {% if request.design_mode %}
                onclick="return false;"
                aria-disabled="true"
              {% endif %}
            {% endunless %}
          >
            <span class="social-icons__icon-label">{{ link_label }}</span>
          </a>
        </div>
      {% endif %}
    {% endif %}
  {% endfor %}
</div>

{% stylesheet %}
  .social-icons__wrapper {
    display: flex;
    gap: var(--gap-sm);
    flex-wrap: wrap;
    justify-content: center;

    @media screen and (min-width: 750px) {
      flex-wrap: nowrap;
      justify-content: flex-start;
    }
  }

  .social-icons__icon-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .social-icons__icon-wrapper a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.45em 0.75em;
    font-family: var(--font-heading--family), 'Bebas Neue', sans-serif;
    font-weight: var(--font-heading--weight);
    font-size: var(--font-size--sm);
    letter-spacing: 0.04em;
    line-height: 1.2;
    text-transform: uppercase;
    text-decoration: none;
    color: inherit;
    border: 1px solid color-mix(in srgb, currentColor 30%, #000);
    border-radius: 0;
  }

  .social-icons__icon-wrapper a:hover {
    border: 1px solid color-mix(in srgb, currentColor 100%, #000);
  }

  .social-icons__icon-label {
    display: block;
  }

  .shopify-design-mode .social-icons__icon-wrapper--disabled {
    opacity: var(--disabled-opacity, 0.5);
    cursor: not-allowed;
  }

  .shopify-design-mode .social-icons__icon-wrapper--disabled a {
    pointer-events: none;
  }
{% endstylesheet %}

