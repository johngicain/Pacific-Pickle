
{% liquid
  assign block_settings = block.settings
  assign heading_preset = block_settings.heading_preset
  assign heading_classes = ''

  if heading_preset == 'custom'
    assign heading_classes = 'custom-typography'
    if block_settings.font_size != blank
      assign heading_classes = heading_classes | append: ' custom-font-size'
      assign font_size_value = block_settings.font_size | split: 'rem' | first | times: 1.0
      if font_size_value >= 3
        assign heading_type = 'display'
      elsif font_size_value >= 1.25
        assign heading_type = 'heading'
      else
        assign heading_type = 'body'
      endif
    endif
  elsif heading_preset != blank
    assign heading_classes = heading_preset
  endif

  if block_settings.weight != blank
    assign heading_classes = heading_classes | append: ' custom-font-weight'
  endif
%}

{% capture accordion_row_children %}
  <details
    class="details"
    data-testid="accordion-details"
    {% if block_settings.open_by_default %}
      open
    {% endif %}
    {{ block.shopify_attributes }}
  >
    <summary
      class="details__header {{ heading_classes }}"
      style="
        {% if heading_preset != blank and heading_preset != 'custom' %}
          --summary-font-family: var(--font-{{ heading_preset }}--family);
          --summary-font-style: var(--font-{{ heading_preset }}--style);
          --summary-font-weight: var(--font-{{ heading_preset }}--weight);
          --summary-font-size: var(--font-{{ heading_preset }}--size);
          --summary-font-line-height: var(--font-{{ heading_preset }}--line-height);
          --summary-font-case: var(--font-{{ heading_preset }}--case);
        {% endif %}
        {% render 'typography-style', settings: block_settings, preset: heading_preset, type: heading_type %}
        {% if block_settings.weight != blank %}--font-weight: {{ block_settings.weight }};{% endif %}
      "
    >
      {% render 'icon-or-image',
        icon: block_settings.icon,
        image_upload: block_settings.image_upload,
        width: block_settings.width,
        class_name: 'details__icon'
      %}
      {{ block_settings.heading }}
      <span class="svg-wrapper icon-caret icon-animated">
        {{- 'icon-caret.svg' | inline_asset_content -}}
      </span>
      <span class="svg-wrapper icon-plus">
        {{- 'icon-plus.svg' | inline_asset_content -}}
      </span>
    </summary>

    <div class="details-content">
      {% content_for 'blocks' %}
    </div>
  </details>
{% endcapture %}
{% render 'accordion-custom-component',
  children: accordion_row_children,
  open_by_default_on_desktop: block_settings.open_by_default,
  open_by_default_on_mobile: block_settings.open_by_default
%}

